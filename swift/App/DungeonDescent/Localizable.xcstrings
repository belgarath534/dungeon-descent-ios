    "Loop-all mode no longer stops silently when a track fails to load — it skips and continues to the next track.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo de loop total não para mais silenciosamente quando uma faixa falha ao carregar — ele pula e continua para a próxima faixa."
          }
