    "Talk to Julio, offer gold, or leave quietly. All outcomes are unpredictable. He is Julio.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fale com Julio, ofereça ouro, ou vá embora silenciosamente. Todos os resultados são imprevisíveis. Ele é Julio."
