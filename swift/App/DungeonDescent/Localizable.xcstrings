      }
    },
    "Translation coverage continues to expand each update.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cobertura de tradução continua a se expandir a cada atualização."
          }
        }
      }
    },
    "Translation shows English immediately then updates to translated text — no blank screen while waiting.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tradução mostra inglês imediatamente depois atualiza para o texto traduzido — sem tela em branco enquanto espera."
          }
        }
      }
    },
    "Translations are automatic — no manual text needed. The game stays up to date as new content is added.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As traduções são automáticas — nenhum texto manual necessário. O jogo se mantém atualizado conforme novo conteúdo é adicionado."
          }
        }
      }
    },
    "Translations are instant — no API call needed for menu text, uses built-in translation table.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As traduções são instantâneas — nenhuma chamada de API necessária para texto de menu, usa uma tabela de tradução embutida."
          }
        }
      }
    },
    "Translations are powered by MyMemory API. Requires internet connection. Translation cache is saved to Firebase when signed in — faster on return visits.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As traduções são feitas pela API MyMemory. Requer conexão à internet. O cache de tradução é salvo no Firebase quando conectado — mais rápido em visitas futuras."
          }
        }
      }
    },
