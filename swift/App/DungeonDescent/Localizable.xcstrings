    "☠ CORRUPTION 75% — Skills begin to backfire.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "☠ CORRUPÇÃO 75% — As habilidades começam a sair pela culatra."
          }
        }
      }
    },
    "☠ Corrupted": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "☠ Corrompido"
          }
        }
      }
    },
    "☠ Corruption System — opt-in toggle in character creation step 9. Every death adds corruption. At 25% the dungeon whispers. At 50% the Corrupted Hunter appears. At 75% skills backfire. At 100% full Corruption Run with doubled gold and legendary rewards.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "☠ Sistema de Corrupção — opção ativável no passo 9 da criação do personagem. Cada morte adiciona corrupção. A 25% a masmorra sussurra. A 50% o Caçador Corrompido aparece. A 75% as habilidades saem pela culatra. A 100% uma Partida de Corrupção completa com ouro dobrado e recompensas lendárias."
          }
        }
      }
    },
    "☠ Corruption: 0%": {
