      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aba da Forja"
          }
        }
      }
    },
    "Forge, upgrade, and buy weapons.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Forje, melhore e compre armas."
          }
        }
      }
    },
    "Forged from volcanic minerals. Restores 45 HP.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Forjada com minerais vulcânicos. Restaura 45 HP."
          }
        }
      }
    },
    "Forged in ashbound fire. +6 defense. Resists heat.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Forjado no fogo das Terras Cinzentas. +6 de defesa. Resiste ao calor."
          }
        }
      }
    },
    "Forged in the Infernal. Burns on every hit.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Forjada no Infernal. Queima a cada golpe."
          }
        }
      }
    },
    "Forged on the first birthday of Dungeon Descent. Exists in only one copy per player.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Forjado no primeiro aniversário de Dungeon Descent. Existe em apenas uma cópia por jogador."
          }
        }
      }
    },
    "Forgot Password — sends reset email. Working.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esqueci a Senha — envia e-mail de redefinição. Funcionando."
          }
        }
      }
    },
    "Forgot password": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esqueci a senha"
          }
        }
      }
    },
    "Forgot password?": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esqueceu a senha?"
          }
        }
      }
    },
    "Form a bone shield — absorb up to 20 damage.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Forme um escudo de osso — absorva até 20 de dano."
          }
        }
      }
    },
    "Formed from snowstorms that fell so deep into the Abyss they never melted. The storm became aware. It has been searching for a way out ever since.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Formado por tempestades de neve que caíram tão fundo no Abismo que nunca derreteram. A tempestade ganhou consciência. Desde então, procura uma saída."
          }
        }
      }
    },
    "Formed from the rarest deposits at the deepest levels. Every facet reflects something. None of the reflections are you.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Formado dos depósitos mais raros nos níveis mais profundos. Cada faceta reflete algo. Nenhum dos reflexos é você."
          }
        }
      }
    },
    "Forsaken": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abandonado"
          }
        }
      }
    },
    "Forsaken, 1 life, 50 percent more enemy damage, most never return": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abandonado, 1 vida, 50 por cento mais dano dos inimigos, a maioria nunca retorna"
          }
        }
      }
    },
    "Found": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrado"
          }
        }
      }
    },
    "Found Void Plate. Defense increased by 10.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrada Placa do Vazio. Defesa aumentada em 10."
          }
        }
      }
    },
    "Found a Battle Scroll. Your next fight deals double damage.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrado um Pergaminho de Batalha. Sua próxima luta causa dano dobrado."
          }
        }
      }
    },
    "Found a Blood Vial. Healed 30 HP.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrado um Frasco de Sangue. Curou 30 HP."
          }
        }
      }
    },
    "Found a Descent Gem. Plus 20 descent points.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrada uma Gema de Descida. Mais 20 pontos de descida."
          }
        }
      }
    },
    "Found a Heavy Stone. Defense plus 5, Attack minus 2.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrada uma Pedra Pesada. Defesa mais 5, Ataque menos 2."
          }
        }
      }
    },
    "Found a Void Shard. Plus 50 percent XP for your next 5 fights.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrado um Fragmento do Vazio. Mais 50 por cento de XP nas próximas 5 lutas."
          }
        }
      }
    },
    "Found an Elixir of Power. Attack plus 10, Defense plus 5.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrado um Elixir de Poder. Ataque mais 10, Defesa mais 5."
          }
        }
      }
    },
    "Found an Herb Bundle. Healed 20 HP and defense plus 2.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrado um Feixe de Ervas. Curou 20 HP e defesa mais 2."
          }
        }
      }
    },
    "Found an Iron Fragment. Defense increased by 3.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrado um Fragmento de Ferro. Defesa aumentada em 3."
          }
        }
      }
    },
    "Found at last. She guards those who showed her mercy.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrada finalmente. Ela protege aqueles que mostraram misericórdia a ela."
          }
        }
      }
    },
    "Found at the bottom of Settings in the red Danger Zone section. Pressing Reset Game opens a confirmation screen listing everything that will be deleted — all characters, achievements, bestiary entries, Hall of Legends records, Library story progress, dungeon unlocks, Mystery Coins, Julio questline progress, and all settings. You must press Delete Everything to confirm. This cannot be undone. The dungeon will not remember your name.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrado na parte inferior de Configurações na seção vermelha Zona de Perigo. Pressionar Reiniciar Jogo abre uma tela de confirmação listando tudo que será excluído — todos os personagens, conquistas, entradas do bestiário, registros do Salão das Lendas, progresso das histórias da Biblioteca, desbloqueios de masmorra, Moedas Misteriosas, progresso da linha de missões de Julio, e todas as configurações. Você deve pressionar Excluir Tudo para confirmar. Isso não pode ser desfeito. A masmorra não vai lembrar seu nome."
          }
        }
      }
    },
    "Found at the bottom of Settings. Allows unlocking all dungeons instantly for testing, resetting dungeon unlocks, resetting the screen reader prompt to show it again, and forcing the 67 Easter egg button to appear. These are developer tools and not part of normal gameplay.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrado na parte inferior de Configurações. Permite desbloquear todas as masmorras instantaneamente para testes, reiniciar desbloqueios de masmorra, reiniciar o prompt do leitor de tela para mostrá-lo novamente, e forçar o botão de easter egg 67 a aparecer. Estas são ferramentas de desenvolvedor e não fazem parte da jogabilidade normal."
          }
        }
      }
    },
    "Found beyond a door that should not open. The Two Doors event always reveals the good path.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrada além de uma porta que não deveria abrir. O evento As Duas Portas sempre revela o bom caminho."
          }
        }
      }
    },
    "Found in Settings under Beta Features. Experimental systems that can be toggled on or off, still being tested and may change in future updates. No beta features are active right now — new experimental systems will appear here as they are developed.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrado em Configurações em Recursos Beta. Sistemas experimentais que podem ser ativados ou desativados, ainda em teste e sujeitos a mudanças em atualizações futuras. Nenhum recurso beta está ativo no momento — novos sistemas experimentais aparecerão aqui conforme forem desenvolvidos."
          }
        }
      }
    },
    "Found in The Chronicles under the Music tab. Browse all 29 tracks in the game grouped by dungeon. Select any track and press Play — the music player uses its own audio system separate from the game so it works from the menu without needing to enter a dungeon first. Press Stop to stop playback. The player also tells you which audio files are missing if you have not added them yet.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrado nas Crônicas na aba Música. Navegue por todas as 29 faixas do jogo agrupadas por masmorra. Selecione qualquer faixa e pressione Tocar — o player de música usa seu próprio sistema de áudio separado do jogo então funciona pelo menu sem precisar entrar em uma masmorra primeiro. Pressione Parar para parar a reprodução. O player também te diz quais arquivos de áudio estão faltando se você ainda não os adicionou."
          }
        }
      }
    },
    "Found in dark dungeon corners. Bioluminescent properties.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrado em cantos escuros da masmorra. Propriedades bioluminescentes."
          }
        }
      }
    },
    "Found in the Hunting Grounds.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrado nos Terrenos de Caça."
          }
        }
      }
    },
    "Found in the main menu. The Bounty Board presents 3 randomly generated bounties per day. Each bounty has a target objective, a specific dungeon, and a gold and trophy reward. Register for one bounty at a time by pressing the Register button. Your active bounty tracks progress automatically as you play — kills, floor reached, and boss defeats all count. Complete the bounty to instantly receive your reward. You can refresh the 3 bounties up to 5 times per day. You do not have to accept any bounty — it is completely optional. Abandon a bounty at any time from the Bounty Board screen.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrado no menu principal. O Quadro de Recompensas apresenta 3 recompensas geradas aleatoriamente por dia. Cada recompensa tem um objetivo alvo, uma masmorra específica e uma recompensa de ouro e troféus. Registre-se para uma recompensa por vez pressionando o botão Registrar. Sua recompensa ativa rastreia o progresso automaticamente enquanto você joga — abates, andar alcançado e derrotas de chefe todos contam. Complete a recompensa para receber sua recompensa instantaneamente. Você pode atualizar as 3 recompensas até 5 vezes por dia. Você não precisa aceitar nenhuma recompensa — é completamente opcional. Abandone uma recompensa a qualquer momento na tela do Quadro de Recompensas."
          }
        }
      }
    },
    "Found in the main menu. The Siege is a fortress defense mode where you defend your base against 10 waves of enemies. Your base has durability instead of HP — if it reaches zero you lose. Before battle upgrade your base using gold and Wave Points. Your character gets a 20 percent HP bonus when entering The Siege. If your HP drops below 50, the enemy switches from attacking you to attacking your base. Heal up fast or your base will fall. Each wave the enemy is 20 percent stronger. Defeat enemies to earn gold and Wave Points — Wave Points are earned by dealing 50 or more damage per wave. Use the Repair Kit between runs to restore base durability. Upgrade your base to level 5 to increase maximum durability. Station captured minions to fight alongside you. If you lose your base falls back to 50 percent durability but you keep your level and Wave Points.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrado no menu principal. O Cerco é um modo de defesa de fortaleza onde você defende sua base contra 10 ondas de inimigos. Sua base tem durabilidade em vez de HP — se chegar a zero você perde. Antes da batalha melhore sua base usando ouro e Pontos de Onda. Seu personagem recebe um bônus de 20 por cento de HP ao entrar no Cerco. Se seu HP cair abaixo de 50, o inimigo muda de te atacar para atacar sua base. Cure-se rápido ou sua base vai cair. A cada onda o inimigo fica 20 por cento mais forte. Derrote inimigos para ganhar ouro e Pontos de Onda — Pontos de Onda são ganhos causando 50 ou mais de dano por onda. Use o Kit de Reparo entre partidas para restaurar a durabilidade da base. Melhore sua base até o nível 5 para aumentar a durabilidade máxima. Estacione servos capturados para lutar ao seu lado. Se você perder, sua base cai para 50 por cento de durabilidade mas você mantém seu nível e Pontos de Onda."
          }
        }
      }
    },
    "Found in the study. Still sharp.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrada no escritório. Ainda afiada."
          }
        }
      }
    },
    "Found what he was looking for. It was not the bride.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrou o que procurava. Não era a noiva."
          }
        }
      }
    },
    "Four full weeks. The fragments could almost speak.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatro semanas completas. Os fragmentos quase poderiam falar."
          }
        }
      }
    },
    "Four heads. Four hits per turn. Deep floor terror.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatro cabeças. Quatro golpes por turno. Terror dos andares profundos."
          }
        }
      }
    },
    "Four horsemen — four strikes of 1.5x each.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatro cavaleiros — quatro golpes de 1,5x cada."
          }
        }
      }
    },
    "Four times a year the dungeon stops sending one enemy at a time. It sends all of them. Every battle is a multi-enemy ambush for a full 24 hours.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatro vezes por ano a masmorra para de enviar um inimigo por vez. Ela envia todos. Cada batalha é uma emboscada com múltiplos inimigos durante 24 horas completas."
          }
        }
      }
    },
    "Fourth of July Event": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Evento do 4 de Julho"
          }
        }
      }
    },
    "Fracture Shade": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sombra Fraturada"
          }
        }
      }
    },
    "Free Smoke Bomb · +20% flee": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bomba de Fumaça grátis · +20% de fuga"
          }
        }
      }
    },
    "Freedom Potion": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Poção da Liberdade"
          }
        }
      }
    },
    "Freedom Potion added to inventory. Heals 100 HP and grants debuff immunity.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Poção da Liberdade adicionada ao inventário. Cura 100 HP e concede imunidade a debuffs."
          }
        }
      }
    },
    "Freeze enemy completely — they cannot act for 3 turns.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Congele o inimigo completamente — ele não pode agir por 3 turnos."
          }
        }
      }
    },
    "Freeze the enemy — skip their next attack.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Congele o inimigo — pule o próximo ataque dele."
          }
        }
      }
    },
    "Freeze the enemy — they deal 30% less damage next turn.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Congele o inimigo — ele causa 30% menos dano no próximo turno."
          }
        }
      }
    },
    "Frenzy attack — deal 1.3x damage for each 10% HP missing.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ataque frenético — cause 1,3x de dano para cada 10% de HP perdido."
          }
        }
      }
    },
    "Friday the 13th": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sexta-feira 13"
          }
        }
      }
    },
    "From a civilization that no longer exists. Strangely warm to the touch.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De uma civilização que não existe mais. Estranhamente quente ao toque."
          }
        }
      }
    },
    "From corrupted enemies. Unstable but powerful.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De inimigos corrompidos. Instável mas poderoso."
          }
        }
      }
    },
    "From the deep dark below the ice. Restores 38 HP.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Da escuridão profunda sob o gelo. Restaura 38 HP."
          }
        }
      }
    },
    "From the deepest shelf. Restores 90 HP.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Da prateleira mais profunda. Restaura 90 HP."
          }
        }
      }
    },
    "From the dungeon hives. Sweet and restorative.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Das colmeias da masmorra. Doce e restaurador."
          }
        }
      }
    },
    "From the main menu press Play. If you have no characters, press New Character. You will go through 7 creation steps — Class, Race, Profession, Name, Dungeon, Difficulty, and an optional Backstory. Then you descend. The dungeon announces every room, every enemy, every event automatically.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No menu principal pressione Jogar. Se você não tem personagens, pressione Novo Personagem. Você vai passar por 7 passos de criação — Classe, Raça, Profissão, Nome, Masmorra, Dificuldade e uma História de Fundo opcional. Depois você desce. A masmorra anuncia cada sala, cada inimigo, cada evento automaticamente."
          }
        }
      }
    },
    "Frontline Fighter": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lutador de Linha de Frente"
          }
        }
      }
    },
    "Frost Crown hardens your defenses. +5 defense!": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Coroa Gélida endurece suas defesas. +5 de defesa!"
          }
        }
      }
    },
    "Frost Crystal": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cristal de Gelo"
          }
        }
      }
    },
    "Frost Lance! Enemy frozen — they skip their next attack.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lança de Gelo! Inimigo congelado — ele pula o próximo ataque."
          }
        }
      }
    },
    "Frost Reaper": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceifador Gélido"
          }
        }
      }
    },
    "Frost Ring": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anel Gélido"
          }
        }
      }
    },
    "Frost Shade": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sombra Gélida"
          }
        }
      }
    },
    "Frost Sprite chills the air — enemy attack reduced for 3 turns.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Espírito Gélido gela o ar — ataque do inimigo reduzido por 3 turnos."
          }
        }
