    "Version 11.0 — The Community Update. Global Chat, PVP rebuilt on Firebase, Community Enemy Creator, and Firebase fully operational. Press Enter the Community to continue.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Versão 11.0 — A Atualização da Comunidade. Chat Global, PVP reconstruído no Firebase, Criador de Inimigos da Comunidade e Firebase totalmente operacional. Pressione Entrar na Comunidade para continuar."
          }
        }
      }
    },
    "Version 11.1": {
      "extractionState": "manual",
