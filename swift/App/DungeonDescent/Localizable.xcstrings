      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estranguladora de Algas"
          }
        }
      }
    },
    "Kept the grounds in perfect condition for thirty years after everyone left. Has opinions about trespassers.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manteve o terreno em perfeitas condições por trinta anos depois que todos partiram. Tem opiniões sobre invasores."
          }
        }
      }
    },
    "Keyboard commands enabled. See Help for full list.": {
      "extractionState": "manual",
