      }
    },
    "Cannot be slowed — guaranteed to move first this turn.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não pode ser retardado — garantido agir primeiro neste turno."
