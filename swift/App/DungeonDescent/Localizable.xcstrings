        }
      }
    },
    "⌨️ Command Center": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⌨️ Centro de Comando"
          }
        }
      }
    },
    "⌨️ New Keyboard Shortcuts — Ctrl+Shift+I for Inventory, Ctrl+Shift+K for Spell Book, Ctrl+Shift+A for Arcane Shop, Ctrl+Shift+M for Seasonal Shop. Combat shortcuts Alt+S for Spells, Alt+E for Examine, Alt+1/2/3 for Skills.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⌨️ Novos Atalhos de Teclado — Ctrl+Shift+I para Inventário, Ctrl+Shift+K para Livro de Feitiços, Ctrl+Shift+A para Loja Arcana, Ctrl+Shift+M para Loja Sazonal. Atalhos de combate Alt+S para Feitiços, Alt+E para Examinar, Alt+1/2/3 para Habilidades."
          }
        }
      }
    },
    "⌨️Command Center": {
      "extractionState": "manual",
