    "🗡️ Starter Weapon — every new adventurer can claim one free Worn Blade from the Blacksmith. Visit the Buy Weapons tab and claim it before your first run.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "🗡️ Arma Inicial — todo novo aventureiro pode reivindicar uma Lâmina Gasta grátis do Ferreiro. Visite a aba Comprar Armas e reivindique-a antes da sua primeira partida."
          }
        }
      }
