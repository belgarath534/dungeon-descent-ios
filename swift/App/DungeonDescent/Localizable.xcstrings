    "🌑 Shadow Ambush — echoes of enemies you already killed this run return from the dark. Every echo adds corruption on hit.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "🌑 Embuscada Sombria — ecos de inimigos que você já matou nesta partida retornam da escuridão. Cada eco adiciona corrupção ao acertar."
          }
        }
      }
    },
    "🌑 Shadow Realm Strategies": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "🌑 Estratégias do Reino das Sombras"
          }
        }
