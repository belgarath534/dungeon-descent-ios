          }
        }
      }
    },
    "THE TIME EATER IS DEFEATED. You have climbed all 1800 floors of The Spire. 1000 gold awarded. 25 Mystery Coins awarded. 25 percent Blacksmith discount active for 2 hours. You have conquered The Spire. This has never been done before.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O DEVORADOR DO TEMPO ESTÁ DERROTADO. Você subiu todos os 1800 andares da Torre. 1000 de ouro concedidos. 25 Moedas Misteriosas concedidas. 25 por cento de desconto no Ferreiro ativo por 2 horas. Você conquistou a Torre. Isso nunca havia sido feito antes."
          }
        }
      }
    },
