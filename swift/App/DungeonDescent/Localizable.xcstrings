    "Worth 14 gold. Black as void.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale 14 de ouro. Negra como o vazio."
          }
        }
      }
    },
    "Worth 15 gold. Not currency from any known place.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale 15 de ouro. Não é moeda de nenhum lugar conhecido."
