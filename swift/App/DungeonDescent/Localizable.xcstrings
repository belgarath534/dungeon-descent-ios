    },
    "That part is already destroyed.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa parte já está destruída."
          }
        }
      }
    },
    "The 5-10MB browser limit that threatened save data as the game grew is now gone. The dungeon can keep expanding.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite de 5-10MB do navegador que ameaçava os dados salvos conforme o jogo crescia agora se foi. A masmorra pode continuar se expandindo."
          }
        }
      }
    },
    "The Abyss stared back at the enemy. Their attack is permanently halved.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Abismo encarou o inimigo de volta. O ataque dele é permanentemente reduzido à metade."
          }
        }
      }
    },
    "The Abyss stared back at you. Your attack is permanently halved.": {
