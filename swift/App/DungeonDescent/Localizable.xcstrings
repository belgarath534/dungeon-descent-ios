            "value": "Sistema de Bônus de Conjunto"
          }
        }
      }
    },
    "Set here to warn if the fire ever went out. The fire never went out. The sentinel has been standing at attention for three hundred years with nothing to report.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Colocado aqui para avisar se o fogo alguma vez se apagasse. O fogo nunca se apagou. A sentinela está em posição de sentido há trezentos anos sem nada a relatar."
          }
        }
      }
    },
    "Set username": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
