          }
        }
      }
    },
    "🎭 Distracted! Enemy attack misses!": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "🎭 Distraído! O ataque do inimigo erra!"
