    "Tiny. Harmless alone. It is never alone. Kill it with heavy force and more come. It knows this. It counts on it.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Minúscula. Inofensiva sozinha. Nunca está sozinha. Mate-a com força pesada e mais virão. Ela sabe disso. Conta com isso."
          }
        }
      }
    },
