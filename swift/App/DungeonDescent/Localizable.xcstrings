          }
        }
      }
    },
    "Dungeon intro sequence — atmospheric text on first visit to each dungeon. The Hollow: the house knows you are here.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sequência de introdução da masmorra — texto atmosférico na primeira visita a cada masmorra. O Vazio: a casa sabe que você está aqui."
          }
        }
      }
    },
    "Dungeon introduction": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdução da masmorra"
          }
        }
      }
    },
    "Dungeon operations approved to continue. Next audit due in two versions.": {
      "extractionState": "manual",
