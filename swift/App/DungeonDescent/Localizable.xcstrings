    "The Shadow World is sealed. It has waited 3000 years. Complete The Abyssal Deep first to break the seal.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mundo das Sombras está selado. Ele esperou 3000 anos. Complete as Profundezas Abissais primeiro para romper o selo."
          }
        }
      }
    },
    "The Shadow World, locked. Complete The Abyssal Deep to unlock.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mundo das Sombras, bloqueado. Complete o Abismo Profundo para desbloquear."
          }
        }
      }
    },
    "The Shadow World. Unlocked. The Shapeshifter awaits.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mundo das Sombras. Desbloqueado. O Metamorfo aguarda."
          }
        }
      }
    },
    "The Shapeshifter. It looks exactly like you. Same class, same level, same weapon. This is the final boss of The Shadow World.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Metamorfo. Se parece exatamente com você. Mesma classe, mesmo nível, mesma arma. Este é o chefe final do Mundo das Sombras."
          }
        }
      }
