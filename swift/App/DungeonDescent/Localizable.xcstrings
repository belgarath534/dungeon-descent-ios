      }
    },
    "Eternal Husk": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Casca Eterna"
          }
        }
      }
    },
    "Ethereal · +AGI +LCK": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Etérea · +AGI +LCK"
          }
        }
      }
    },
    "Even the dead are quiet tonight.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até os mortos estão quietos esta noite."
          }
        }
      }
    },
    "Event": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Evento"
          }
        }
      }
    },
    "Event XP bonuses now apply correctly.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bônus de XP de evento agora se aplicam corretamente."
          }
        }
      }
    },
    "Event banner in dungeon now shows hours remaining until event ends.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O banner de evento na masmorra agora mostra as horas restantes até o evento terminar."
          }
        }
      }
    },
    "Events": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eventos"
          }
        }
      }
    },
    "Events activate automatically based on the date and time.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eventos se ativam automaticamente baseados na data e hora."
          }
        }
      }
    },
    "Events and Challenges Audit": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Auditoria de Eventos e Desafios"
          }
        }
      }
    },
    "Events list": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista de eventos"
          }
        }
      }
    },
    "Events screen in main menu — see active events, days remaining, upcoming events": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tela de Eventos no menu principal — veja eventos ativos, dias restantes, eventos futuros"
          }
        }
      }
    },
    "Events.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eventos."
          }
        }
      }
    },
    "Every 3 turns it screams, silencing your skills for 1 turn.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cada 3 turnos ele grita, silenciando suas habilidades por 1 turno."
          }
        }
      }
    },
    "Every 3rd attack deals bonus holy damage equal to your level times 3.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada 3º ataque causa dano sagrado bônus igual ao seu nível vezes 3."
          }
        }
      }
    },
    "Every Monday the dungeon is darker than usual. Enemies are harder. Gold is worth more. The void is not a punishment. The void is a test.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda segunda-feira a masmorra fica mais escura que o normal. Inimigos são mais difíceis. O ouro vale mais. O vazio não é um castigo. O vazio é um teste."
          }
        }
      }
    },
    "Every Saturday and Sunday the dungeon rewards the dedicated. Double XP. No catch. The DDDI did not authorize this but also did not stop it.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo sábado e domingo a masmorra recompensa os dedicados. XP dobrado. Sem pegadinha. A DDDI não autorizou isso, mas também não impediu."
          }
        }
      }
    },
    "Every achievement earns you": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda conquista te dá"
          }
        }
      }
    },
    "Every achievement now rewards gold and trophies when unlocked. Easy achievements give 50 gold and 1 trophy. Medium give 150 gold and 3 trophies. Hard give 400 gold and 7 trophies. When you first open the game after updating, all previously unlocked achievements are retroactively rewarded. Your trophy count appears on the main menu — tap it to see your full collection. Reaching 100 trophies unlocks The Infernal Descent automatically.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda conquista agora recompensa ouro e troféus quando desbloqueada. Conquistas fáceis dão 50 de ouro e 1 troféu. Médias dão 150 de ouro e 3 troféus. Difíceis dão 400 de ouro e 7 troféus. Quando você abre o jogo pela primeira vez após atualizar, todas as conquistas anteriormente desbloqueadas são recompensadas retroativamente. Sua contagem de troféus aparece no menu principal — toque para ver sua coleção completa. Alcançar 100 troféus desbloqueia A Descida Infernal automaticamente."
          }
        }
      }
    },
    "Every action in the game earns score points. Kills earn 10 points each, elite kills 150, boss kills 500, dungeon clears 1000, achievements 250, daily quests 300, gold collected 1 point each. Your lifetime total score determines your rank — from Initiate all the way up to DDDI Certified at 100,000 points. View your score breakdown and rank from the High Score button on the main menu.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda ação no jogo ganha pontos de pontuação. Abates ganham 10 pontos cada, abates de elite 150, abates de chefe 500, masmorras completadas 1000, conquistas 250, missões diárias 300, ouro coletado 1 ponto cada. Sua pontuação total vitalícia determina seu rank — de Iniciado até Certificado DDDI em 100.000 pontos. Veja sua análise de pontuação e rank pelo botão Pontuação Máxima no menu principal."
          }
        }
      }
    },
    "Every action in the game is announced. Combat damage, loot found, floor descriptions — your screen reader reads it all.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ação no jogo é anunciada. Dano de combate, saque encontrado, descrições de andar — seu leitor de tela lê tudo."
          }
        }
      }
    },
    "Every attack applies poison for 4 damage per turn for 3 turns. Stacks with each hit.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ataque aplica veneno causando 4 de dano por turno durante 3 turnos. Acumula com cada golpe."
          }
        }
      }
    },
    "Every attack has 25% chance to explode for double damage. Chaos fuels your magic.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ataque tem 25% de chance de explodir causando dano dobrado. O caos alimenta sua magia."
          }
        }
      }
    },
    "Every character bonds with a spirit companion before their first run. Spirits give passive bonuses every run and deal bonus damage in combat. You earn rare spirits by defeating bosses and special enemies. Spirits are permanent — they stay with your character forever. You can change your active spirit between runs from the character screen.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo personagem se vincula a um espírito companheiro antes de sua primeira partida. Espíritos dão bônus passivos em cada partida e causam dano bônus em combate. Você conquista espíritos raros derrotando chefes e inimigos especiais. Espíritos são permanentes — eles ficam com seu personagem para sempre. Você pode mudar seu espírito ativo entre partidas na tela do personagem."
          }
        }
      }
    },
    "Every class has unique legendary skills that change how the game plays": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda classe tem habilidades lendárias únicas que mudam como o jogo é jogado"
          }
        }
      }
    },
    "Every class now begins floor 1 with their signature skill already unlocked. Warriors start with Shield Bash, Assassins with Backstab, Wizards with Arcane Bolt, and so on for every class. The starting skill is removed from your skill pool so you will not be offered it again when leveling up.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda classe agora começa o andar 1 com sua habilidade característica já desbloqueada. Guerreiros começam com Golpe de Escudo, Assassinos com Ataque Furtivo, Magos com Raio Arcano, e assim por diante para cada classe. A habilidade inicial é removida do seu conjunto de habilidades então você não será oferecido ela novamente ao subir de nível."
          }
        }
      }
    },
    "Every combat opens with a devastating first strike — 75% bonus damage on the opening hit. Hard to catch, harder to kill.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo combate começa com um golpe devastador — 75% de dano bônus no primeiro ataque. Difícil de pegar, mais difícil de matar."
          }
        }
      }
    },
    "Every death darkens your soul. Survive long enough and the dungeon will fear you.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada morte escurece sua alma. Sobreviva tempo suficiente e a masmorra vai temer você."
          }
        }
      }
    },
    "Every dungeon boss has 3 phases. Each phase transition makes the boss stronger and changes its attack pattern. A boss preview screen shows the boss name and HP before combat begins — read it carefully. General tips: save at least 2 potions before floor 10. Use your strongest skill in phase 1 while the boss is weakest. Defend during phase transitions to reduce the burst damage. If you have a spirit active use its combat skill every cooldown. The boss scales with your player level so higher level characters face stronger bosses — there is no free ride.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo chefe de masmorra tem 3 fases. Cada transição de fase torna o chefe mais forte e muda seu padrão de ataque. Uma tela de pré-visualização do chefe mostra o nome e o HP do chefe antes do combate começar — leia com atenção. Dicas gerais: guarde pelo menos 2 poções antes do andar 10. Use sua habilidade mais forte na fase 1 enquanto o chefe está mais fraco. Defenda durante as transições de fase para reduzir o dano em explosão. Se você tem um espírito ativo, use sua habilidade de combate em cada recarga. O chefe escala com o nível do seu jogador, então personagens de nível mais alto enfrentam chefes mais fortes — não existe vitória fácil."
          }
        }
      }
    },
    "Every dungeon run rolls a random weather condition at the start. Each dungeon has its own weather pool. Effects include enemy ATK multipliers, gold boosts, HP loss per room, SP discounts, and healing per kill. The condition is announced by the screen reader and shown in the weather banner at the top of the dungeon screen.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada partida de masmorra sorteia uma condição climática aleatória no início. Cada masmorra tem seu próprio conjunto de climas. Os efeitos incluem multiplicadores de ATQ do inimigo, bônus de ouro, perda de HP por sala, descontos de SP e cura por abate. A condição é anunciada pelo leitor de tela e mostrada no banner de clima no topo da tela da masmorra."
          }
        }
      }
    },
    "Every enemy in the game is now trackable in the bestiary": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo inimigo no jogo agora é rastreável no bestiário"
          }
        }
      }
    },
    "Every fall. Every run. Every moment the dungeon won.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada queda. Cada partida. Cada momento em que a masmorra venceu."
          }
        }
      }
    },
    "Every floor generates a room sequence with possible special rooms — Treasure Chamber (loot, no combat), Sanctuary (heal 20% HP), Cursed Chamber (elite, triple gold), Hidden Passage (secret gold), and Wandering Merchant (mid-dungeon shop with 4 to 5 items).": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada andar gera uma sequência de salas com possíveis salas especiais — Câmara do Tesouro (saque, sem combate), Santuário (cura 20% de HP), Câmara Amaldiçoada (elite, ouro triplo), Passagem Oculta (ouro secreto) e Mercador Errante (loja no meio da masmorra com 4 a 5 itens)."
          }
        }
      }
    },
    "Every forest has ghosts. This one has more than most.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda floresta tem fantasmas. Esta tem mais que a maioria."
          }
        }
      }
    },
    "Every fragment recovered. The full truth of Julio is finally yours.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo fragmento recuperado. A verdade completa de Julio finalmente é sua."
          }
        }
      }
    },
    "Every hit takes something from you that is not health. You do not notice at first. You notice later.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada golpe tira algo de você que não é saúde. Você não percebe a princípio. Percebe depois."
          }
        }
      }
    },
    "Every kill gives +2 ATK for the rest of the floor. Commander energy. Built for momentum.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada abate dá +2 ATQ pelo resto do andar. Energia de comandante. Feito para o embalo."
          }
        }
      }
    },
    "Every kill this combat restores 10 HP and 3 SP.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada abate neste combate restaura 10 HP e 3 SP."
          }
        }
      }
    },
    "Every kill, every achievement, every dungeon cleared earns points. This is your legacy.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada abate, cada conquista, cada masmorra completada ganha pontos. Este é seu legado."
          }
        }
      }
    },
    "Every level up gives 3 points to spend across 6 stats. STR Strength adds 2 ATK. STA Stamina adds 10 max HP. DEF Defense adds 2 damage reduction. INT Intelligence adds 5 max SP. AGI Agility adds 3 percent crit chance and 5 percent flee chance. LCK Luck adds 10 percent gold drops. Unspent points carry over between levels. Subclasses at level 5 also grant automatic stat bonuses based on their specialization.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada subida de nível dá 3 pontos para gastar em 6 atributos. STR Força adiciona 2 ATQ. STA Vigor adiciona 10 de HP máximo. DEF Defesa adiciona 2 de redução de dano. INT Inteligência adiciona 5 de SP máximo. AGI Agilidade adiciona 3 por cento de chance de crítico e 5 por cento de chance de fuga. LCK Sorte adiciona 10 por cento de ouro obtido. Pontos não gastos são mantidos entre níveis. Subclasses no nível 5 também concedem bônus automáticos de atributos baseados em sua especialização."
          }
        }
      }
    },
    "Every level up gives 3 points to spend across 6 stats. Unspent points carry over between levels. STR — Strength adds 2 ATK per point. STA — Stamina adds 10 max HP per point. DEF — Defense adds 2 damage reduction per point. INT — Intelligence adds 5 max SP per point, making skills cheaper to sustain. AGI — Agility adds 3% crit chance and 5% flee chance per point. LCK — Luck adds 10% gold drops and better loot quality per point. Choose stats that match your playstyle — a high INT Wizard can spam skills all day while a high STR Warrior hits harder but runs out of SP faster.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada subida de nível dá 3 pontos para gastar em 6 atributos. Pontos não gastos são mantidos entre níveis. STR — Força adiciona 2 ATQ por ponto. STA — Vigor adiciona 10 de HP máximo por ponto. DEF — Defesa adiciona 2 de redução de dano por ponto. INT — Inteligência adiciona 5 de SP máximo por ponto, tornando habilidades mais baratas de sustentar. AGI — Agilidade adiciona 3% de chance de crítico e 5% de chance de fuga por ponto. LCK — Sorte adiciona 10% de ouro obtido e melhor qualidade de saque por ponto. Escolha atributos que combinem com seu estilo de jogo — um Mago com INT alto pode usar habilidades o dia todo enquanto um Guerreiro com STR alto bate mais forte mas fica sem SP mais rápido."
          }
        }
      }
    },
    "Every line of code. Every dungeon room. Every boss fight. Every story. Built together.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada linha de código. Cada sala da masmorra. Cada luta de chefe. Cada história. Construído juntos."
          }
        }
      }
    },
    "Every night from 8PM to 8AM Night Mode activates automatically based on your device clock. You earn 50% more gold from all sources and shop prices are 25% cheaper. Stacks with all other active events — Night Mode during Void Week means massive gold. A banner on the main menu and in the dungeon shows Night Mode is active and how many hours remain.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda noite das 20h às 8h o Modo Noturno se ativa automaticamente baseado no relógio do seu dispositivo. Você ganha 50% mais ouro de todas as fontes e os preços da loja são 25% mais baratos. Acumula com todos os outros eventos ativos — Modo Noturno durante a Semana do Vazio significa ouro massivo. Um banner no menu principal e na masmorra mostra que o Modo Noturno está ativo e quantas horas restam."
          }
        }
      }
    },
    "Every room can contain": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada sala pode conter"
          }
        }
      }
    },
    "Every selection screen in the game has a slider above the options. On VoiceOver swipe up to go to the next option, swipe down to go back. On JAWS use the arrow keys. The ◀ and ▶ buttons work as a tap fallback on any device. Sliders are available for class, race, profession, dungeon, difficulty, and backstory in character creation. They are also on every character picker — the character list, AFK setup, The Spire, Boss Rush, Daily Raid, and Tournament. The character list slider also has a Play button so you can play your character directly from the slider without navigating into the cards.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda tela de seleção no jogo tem um controle deslizante acima das opções. No VoiceOver deslize para cima para ir à próxima opção, deslize para baixo para voltar. No JAWS use as setas do teclado. Os botões ◀ e ▶ funcionam como alternativa de toque em qualquer dispositivo. Controles deslizantes estão disponíveis para classe, raça, profissão, masmorra, dificuldade e história de fundo na criação do personagem. Também estão em todo seletor de personagem — a lista de personagens, configuração AFK, a Torre, Assalto de Chefes, Missão Diária e Torneio. O controle deslizante da lista de personagens também tem um botão Jogar para que você possa jogar seu personagem diretamente do controle deslizante sem navegar pelos cartões."
          }
        }
      }
    },
    "Every skeleton in the crypt eventually becomes part of it.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo esqueleto da cripta acaba se tornando parte dele."
          }
        }
      }
    },
    "Every story. Every secret. The dungeon has no more to hide from you.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda história. Todo segredo. A masmorra não tem mais nada para esconder de você."
          }
        }
      }
    },
    "Every time you die, your character gains corruption. At 25% enemies begin to whisper. At 50% a Corrupted hunter stalks you. At 75% your skills backfire. At 100% you enter a legendary Corruption Run with massive rewards. This is for hardcore players.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada vez que você morre, seu personagem ganha corrupção. A 25%, os inimigos começam a sussurrar. A 50%, um caçador Corrompido te persegue. A 75%, suas habilidades saem pela culatra. A 100%, você entra em uma Partida de Corrupção lendária com recompensas massivas. Isso é para jogadores extremos."
          }
        }
      }
    },
    "Every time you encounter Julio in the dungeon he gives you a fragment — a note, a memo, a name tag, a lunch schedule. Collect all 5 fragments across multiple runs with any character. When you collect all 5 a new Library story unlocks — written entirely by Julio himself, explaining who he is and why he is always in the dungeon. The explanation is completely mundane. Achievement: Found Him.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada vez que você encontra Julio na masmorra ele te dá um fragmento — uma nota, um memorando, uma etiqueta de nome, um horário de almoço. Colete todos os 5 fragmentos em várias partidas com qualquer personagem. Quando você coleta todos os 5, uma nova história da Biblioteca é desbloqueada — escrita inteiramente pelo próprio Julio, explicando quem ele é e por que está sempre na masmorra. A explicação é completamente mundana. Conquista: Encontrei Ele."
          }
        }
      }
    },
    "Every time you enter The Hollow the game rolls one of 5 weather conditions. Foggy Night adds 15 percent combat chance. Full Moon makes enemies 20 percent stronger but gold drops 50 percent more. Silent Night doubles Weeping Child spawn rate. The Witching Hour gives you 25 percent more damage but enemies crit more. Still and Cold has no effect — the house is just watching.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada vez que você entra no Vazio o jogo sorteia uma das 5 condições climáticas. Noite Nebulosa adiciona 15 por cento de chance de combate. Lua Cheia torna os inimigos 20 por cento mais fortes mas o ouro cai 50 por cento mais. Noite Silenciosa dobra a taxa de aparição da Criança Chorosa. A Hora das Bruxas te dá 25 por cento mais dano mas inimigos acertam mais críticos. Quieta e Fria não tem efeito — a casa está apenas observando."
          }
        }
      }
    },
    "Every time you start a run your screen reader reads a single line specific to your class and dungeon combination. 60 unique lines total — one for each of the 12 classes in each of the 5 dungeons. The line sets the tone for the run before the dungeon intro begins.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada vez que você inicia uma partida seu leitor de tela lê uma única frase específica para sua combinação de classe e masmorra. 60 frases únicas no total — uma para cada uma das 12 classes em cada uma das 5 masmorras. A frase define o tom da partida antes da introdução da masmorra começar."
          }
        }
      }
    },
    "Every wound you give it comes back to you, smaller but certain. Hit it hard and fast or pay every time.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo ferimento que você causa volta para você, menor, mas certo. Acerte forte e rápido ou pague todas as vezes."
          }
        }
      }
    },
    "Everyone else left. It stayed. It was responsible for the collection. The collection is still here.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os outros partiram. Ela ficou. Era responsável pelo acervo. O acervo ainda está aqui."
          }
        }
      }
    },
    "Everything that happened this run. Most recent at the top.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo que aconteceu nesta partida. Mais recente no topo."
          }
        }
      }
    },
    "Everything the Bone Colossus is, made of nightmare instead of bone. It is larger than it should be able to fit in this corridor. The corridor disagreed and lost.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo que o Colosso Ósseo é, feito de pesadelo em vez de osso. É maior do que deveria caber neste corredor. O corredor discordou e perdeu."
          }
        }
      }
    },
    "Everything was tried. The dungeon is what remains.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo foi tentado. A masmorra é o que resta."
          }
        }
      }
    },
    "Everything you need to know about Dungeon Descent. Use your screen reader heading navigation to jump between sections.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo que você precisa saber sobre Dungeon Descent. Use a navegação por cabeçalhos do seu leitor de tela para saltar entre seções."
          }
        }
      }
    },
    "Evolved in the void between depths. Gets faster and stronger every turn it survives.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Evoluiu no vazio entre as profundezas. Fica mais rápido e mais forte a cada turno que sobrevive."
          }
        }
      }
    },
    "Evolved to move through the void between the deep and the deeper. Has no natural predators. Has no natural anything. It simply is.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Evoluiu para se mover pelo vazio entre o profundo e o mais profundo. Não tem predadores naturais. Não tem nada natural. Ele simplesmente é."
          }
        }
      }
    },
    "Examine enemy to learn their weakness and abilities": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Examinar o inimigo para descobrir suas fraquezas e habilidades"
          }
        }
      }
    },
    "Examine.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Examinar."
          }
        }
      }
    },
    "Examples of high-risk legendary spells: Shadow Blast summons a void spirit that can instantly kill you if it rejects you. Time Stop freezes time for 3 free attacks but has a 50% chance of defeating you instantly if it fails. Lose Reality gives you 5 minutes to kill the enemy or you cease to exist — a real countdown timer begins. The Abyss Stares Back has a 40% chance to halve the enemy attack permanently and a 60% chance to halve yours permanently with no way to undo it.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exemplos de feitiços lendários de alto risco: Explosão Sombria convoca um espírito do vazio que pode te matar instantaneamente se ele te rejeitar. Parada do Tempo congela o tempo para 3 ataques gratuitos mas tem 50% de chance de te derrotar instantaneamente se falhar. Perder a Realidade te dá 5 minutos para matar o inimigo ou você deixa de existir — um cronômetro real começa. O Abismo Olha de Volta tem 40% de chance de reduzir o ataque do inimigo à metade permanentemente e 60% de chance de reduzir o seu à metade permanentemente sem forma de desfazer."
          }
        }
      }
    },
    "Exclusive enemies spawn 30% of fights at t3 (floor 20+) and 50% at t4 (floor 31+).": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inimigos exclusivos aparecem em 30% das lutas no t3 (andar 20+) e 50% no t4 (andar 31+)."
          }
        }
      }
    },
    "Execute command": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Executar comando"
          }
        }
      }
    },
    "Exiled Noble": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobre Exilado"
          }
        }
      }
    },
    "Exists between dimensions. Can phase through attacks. Void spells hit harder. High risk, high reward playstyle.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Existe entre dimensões. Pode atravessar ataques. Feitiços do vazio golpeiam mais forte. Estilo de jogo de alto risco e alta recompensa."
          }
        }
      }
    },
    "Exists partially in the shadow plane. The half you can see is not the dangerous half.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Existe parcialmente no plano das sombras. A metade que você vê não é a metade perigosa."
          }
        }
      }
    },
    "Experimental features — test before they go live": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recursos experimentais — teste antes de irem ao ar"
          }
        }
      }
    },
    "Experimental formula — massive random damage (1x to 6x).": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fórmula experimental — dano aleatório massivo (1x a 6x)."
          }
        }
      }
    },
    "Explode a fallen enemy — 2.5x damage to current enemy.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exploda um inimigo caído — 2,5x de dano ao inimigo atual."
          }
        }
      }
    },
    "Explode a fallen enemy — deal massive damage based on their max HP.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exploda um inimigo caído — cause dano massivo baseado no HP máximo dele."
          }
        }
      }
    },
    "Export ": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportar "
          }
        }
      }
    },
    "Export Save": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportar Salvo"
          }
        }
      }
    },
    "Export Save Code": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportar Código de Save"
          }
        }
      }
    },
    "Export a character as a code": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportar um personagem como código"
          }
        }
      }
    },
    "Export any character as a code using the Export button in the character list. The code contains everything about that character — class, race, skills, death log, earned spirits. Share the code with another device or person and import it using the Import button. Useful for backing up characters or sharing your build with friends.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte qualquer personagem como um código usando o botão Exportar na lista de personagens. O código contém tudo sobre aquele personagem — classe, raça, habilidades, registro de mortes, espíritos conquistados. Compartilhe o código com outro dispositivo ou pessoa e importe-o usando o botão Importar. Útil para fazer backup de personagens ou compartilhar sua build com amigos."
          }
        }
      }
    },
    "Export failed. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportação falhou. Por favor, tente novamente."
          }
        }
      }
    },
    "Export save code": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportar código de save"
          }
        }
      }
    },
    "Extra Potion": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Poção Extra"
          }
        }
      }
    },
    "Extra health potion added to your supplies.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Poção de cura extra adicionada aos seus suprimentos."
          }
        }
      }
    },
    "Extracted from shadow creatures. Absorbs light.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Extraído de criaturas sombrias. Absorve luz."
          }
        }
      }
    },
    "Extraction failed. Void Curse cripples your attacks until next floor.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Extração falhou. Maldição do Vazio prejudica seus ataques até o próximo andar."
          }
        }
      }
    },
    "Extraction success! You control the enemy's next hit.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Extração bem-sucedida! Você controla o próximo golpe do inimigo."
          }
        }
      }
    },
    "FIRE · 10 FLOORS · 17 ENEMIES · 3 BOSSES": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "FOGO · 10 ANDARES · 17 INIMIGOS · 3 CHEFES"
          }
        }
      }
    },
    "FLOOR": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ANDAR"
          }
        }
      }
    },
    "FREE": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "GRÁTIS"
          }
        }
      }
    },
    "Face The Void Reaper": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enfrentar o Ceifador do Vazio"
          }
        }
      }
    },
    "Face The Void Reaper — world event active": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enfrentar o Ceifador do Vazio — evento mundial ativo"
          }
        }
      }
    },
    "Face every boss from every dungeon back to back. A small healing window between each fight. Defeat 3 for a Mystery Coin. Defeat 6 for 3 coins. Defeat all 9 for 6 coins. It has never been done.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enfrente todo chefe de toda masmorra seguido. Uma pequena janela de cura entre cada luta. Derrote 3 por uma Moeda Misteriosa. Derrote 6 por 3 moedas. Derrote todos os 9 por 6 moedas. Nunca foi feito."
          }
        }
      }
    },
    "Face the Void Reaper": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enfrentar o Ceifador do Vazio"
          }
        }
      }
    },
    "Face the boss": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enfrentar o chefe"
          }
        }
      }
    },
    "Face the next wave of shadow entities": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enfrentar a próxima onda de entidades das sombras"
          }
        }
      }
    },
    "Face three waves of void entities. No equipment. No potions. Base stats only. Survive and the gate opens.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enfrente três ondas de entidades do vazio. Sem equipamento. Sem poções. Apenas atributos base. Sobreviva e o portão se abre."
          }
        }
      }
    },
    "Fae": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fada"
          }
        }
      }
    },
    "Fail to defeat him in 16 hours — all dungeon enemies are 25% stronger for 24 hours as punishment. Then the cycle resets.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falhe em derrotá-lo em 16 horas — todos os inimigos de masmorra ficam 25% mais fortes por 24 horas como punição. Depois o ciclo reinicia."
          }
        }
      }
    },
    "Failed to send message. Check your connection.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha ao enviar mensagem. Verifique sua conexão."
          }
        }
      }
    },
    "Failed. The child woke up angry. Combat starting.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falhou. A criança despertou furiosa. Combate começando."
          }
        }
      }
    },
    "Failed. The child woke up. Combat starting now.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falhou. A criança despertou. Combate começando agora."
          }
        }
      }
    },
    "Failure to comply results in a 359,000,000 year suspension of dungeon access.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O não cumprimento resulta em uma suspensão de 359.000.000 de anos do acesso à masmorra."
          }
        }
      }
    },
    "Failure to comply with DDDI audit requirements results in a 359,000,000 year suspension.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O não cumprimento dos requisitos de auditoria da DDDI resulta em uma suspensão de 359.000.000 de anos."
          }
        }
      }
