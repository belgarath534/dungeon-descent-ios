    },
    "Win — earn 3 Mystery Coins. Cycle resets.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vença — ganhe 3 Moedas Misteriosas. O ciclo reinicia."
          }
        }
      }
    },
    "Wind Step — attack dodged!": {
