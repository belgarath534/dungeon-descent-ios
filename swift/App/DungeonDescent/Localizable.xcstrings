    "Version 10.7 — The Storage Upgrade. IndexedDB migration, unlimited save storage, music loop fix, and more. Press Into the Dark Again to continue.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Versão 10.7 — A Melhoria de Armazenamento. Migração para IndexedDB, armazenamento de save ilimitado, correção do loop de música e mais. Pressione De Volta à Escuridão para continuar."
          }
        }
      }
    },
