      }
    },
    "Seven trials completed. The dungeon bows to no one — except you.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sete provações completas. A masmorra não se inclina para ninguém — exceto você."
