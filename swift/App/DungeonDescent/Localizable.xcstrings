        }
      }
    },
    "Notified on the 8th of each month — bonus XP and unique encounters.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificado no dia 8 de cada mês — XP bônus e encontros únicos."
          }
        }
      }
    },
    "Notified when Friday the 13th arrives.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificado quando a Sexta-feira 13 chega."
          }
        }
      }
    },
    "Nova of death — 2.5x damage in a burst.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nova da morte — 2,5x de dano em uma explosão."
          }
        }
      }
    },
    "Now tap the button three times matching the same rhythm.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora toque o botão três vezes seguindo o mesmo ritmo."
          }
        }
      }
    },
    "Nullify enemy — their defense drops to 0 for 2 turns.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anule o inimigo — a defesa dele cai para 0 por 2 turnos."
          }
        }
      }
    },
    "Number of coins": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
