    "Epic war song — your attack is doubled for 2 turns.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Canção épica de guerra — seu ataque é dobrado por 2 turnos."
          }
        }
      }
