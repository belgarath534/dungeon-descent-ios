            "value": "Espírito do Mercado — novo espírito inicial dando 20% de desconto na loja durante toda a partida"
          }
        }
      }
    },
    "Mask immunity — hit absorbed!": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
