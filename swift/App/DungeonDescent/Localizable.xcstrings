    "Tear reality — 2.5x damage, enemy loses 5 ATK permanently.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rasgue a realidade — 2,5x de dano, inimigo perde 5 ATQ permanentemente."
          }
