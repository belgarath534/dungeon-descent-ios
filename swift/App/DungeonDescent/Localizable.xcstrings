            "state": "translated",
            "value": "☠ Corrupção: 0%"
          }
        }
      }
    },
    "☠ Death Log": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "☠ Registro de Mortes"
          }
        }
      }
    },
    "☠ Death Log — a new screen accessible from the character list. Shows every death for every character — floor, killer, dungeon, difficulty, kills, gold, and flavor text.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "☠ Registro de Mortes — uma nova tela acessível pela lista de personagens. Mostra toda morte de todo personagem — andar, causador, masmorra, dificuldade, abates, ouro e texto de sabor."
          }
        }
      }
    },
    "☠ FULL CORRUPTION — You are beyond saving. The dungeon trembles.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
