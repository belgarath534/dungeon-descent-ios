    "Entropy hits — each attack this turn deals 10% more than the last.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Golpes de entropia — cada ataque neste turno causa 10% mais que o anterior."
