    },
    "Worth 20 gold. Sell it at the Blacksmith.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale 20 de ouro. Venda-a ao Ferreiro."
          }
        }
      }
    },
    "Worth 20 gold. Something inside it moves.": {
      "extractionState": "manual",
