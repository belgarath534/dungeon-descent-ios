      }
    },
    "Adds H1, H2, H3 headings to screens so JAWS users can navigate with the H key. Recommended for heading navigation users.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona cabeçalhos H1, H2, H3 às telas para que usuários do JAWS possam navegar com a tecla H. Recomendado para usuários de navegação por cabeçalho."
          }
        }
      }
    },
    "Adds a chat button inside the dungeon screen": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona um botão de chat dentro da tela da masmorra"
          }
        }
      }
    },
    "Adopt the Easter Bunny as your spirit companion": {
      "extractionState": "manual",
      "localizations": {
