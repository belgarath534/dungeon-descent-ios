        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pontos de descida insuficientes."
          }
        }
      }
    },
    "Not enough fragments.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
