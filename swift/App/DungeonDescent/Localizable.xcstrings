          }
        }
      }
    },
    "Testing and debug options": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opções de teste e depuração"
          }
        }
      }
    },
    "Thank you for watching! 10 Mystery Coins added to your account.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado por assistir! 10 Moedas Misteriosas adicionadas à sua conta."
          }
        }
      }
    },
    "That enemy is already defeated.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse inimigo já está derrotado."
          }
        }
      }
    },
    "That is everything you need to know. The rest you will learn in the dark.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso é tudo que você precisa saber. O resto você vai aprender na escuridão."
          }
