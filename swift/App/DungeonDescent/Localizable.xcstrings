      }
    },
    "— tap Choose Audio File and pick any audio file from your device. Works with MP3, WAV, M4A, OGG and more. iOS users can pick from the Files app. The track plays immediately and you are asked if you want to save it.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "— toque em Escolher Arquivo de Áudio e escolha qualquer arquivo de áudio do seu dispositivo. Funciona com MP3, WAV, M4A, OGG e mais. Usuários de iOS podem escolher pelo app Arquivos. A faixa toca imediatamente e você é perguntado se quer salvá-la."
          }
        }
      }
    },
    "— tap the ⏸ button in the dungeon topbar next to the quit button.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "— toque no botão ⏸ na barra superior da masmorra ao lado do botão de saída."
