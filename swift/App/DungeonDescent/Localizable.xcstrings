    "☁ Account System (Alpha) — cloud saves via Firebase. Sign in with email or Google. Progress syncs to the cloud automatically every time the game saves.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "☁ Sistema de Conta (Alfa) — saves na nuvem via Firebase. Entre com e-mail ou Google. O progresso sincroniza com a nuvem automaticamente toda vez que o jogo salva."
          }
        }
      }
    },
    "☁ Cloud Audio — all 50+ audio files now stream from Supabase CDN. The game is now a single HTML file — no local audio folder needed.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "☁ Áudio na Nuvem — todos os mais de 50 arquivos de áudio agora transmitem do CDN Supabase. O jogo agora é um único arquivo HTML — sem necessidade de pasta de áudio local."
          }
        }
      }
    },
