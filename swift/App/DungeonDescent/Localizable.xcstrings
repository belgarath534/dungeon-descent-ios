      }
    },
    "— swift hunter. First hit every combat deals 75% bonus damage. High flee chance.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "— caçador veloz. O primeiro golpe de cada combate causa 75% de dano bônus. Alta chance de fuga."
          }
