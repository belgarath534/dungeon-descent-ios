            "value": "O Desfazer"
          }
        }
      }
    },
    "The Unwritten gave you 100 gold.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Não Escrito te deu 100 de ouro."
          }
        }
      }
    },
    "The Unwritten granted plus 8 attack.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Não Escrito concedeu mais 8 de ataque."
          }
        }
      }
    },
    "The Unwritten healed you 40 HP.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Não Escrito te curou 40 HP."
          }
        }
      }
    },
    "The Unwritten stunned the enemy.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Não Escrito atordoou o inimigo."
          }
        }
      }
    },
    "The Void Below": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Vazio Abaixo"
          }
        }
      }
    },
    "The Void Chronicles": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As Crônicas do Vazio"
          }
        }
      }
    },
    "The Void Given Form": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Vazio Feito Forma"
          }
        }
      }
    },
    "The Void King": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Rei do Vazio"
          }
        }
      }
    },
    "The Void Reaper": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Ceifador do Vazio"
          }
        }
      }
    },
    "The Void Reaper endures. But your damage to the global boss carries on.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Ceifador do Vazio resiste. Mas seu dano ao chefe global permanece."
          }
        }
      }
    },
    "The Void Reaper has already been defeated.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Ceifador do Vazio já foi derrotado."
          }
        }
      }
    },
    "The Void Reaper has already fallen.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Ceifador do Vazio já caiu."
          }
        }
      }
    },
    "The Void Reaper has been defeated. Every player who struck it shares in the victory.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Ceifador do Vazio foi derrotado. Todo jogador que o atingiu compartilha da vitória."
          }
        }
      }
    },
    "The Void Reaper has not awakened yet.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Ceifador do Vazio ainda não despertou."
          }
        }
      }
    },
    "The Void Reaper was supposed to be unkillable. You did not know that.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Ceifador do Vazio deveria ser invencível. Você não sabia disso."
          }
        }
      }
    },
    "The Void Retreats": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Vazio Recua"
          }
        }
      }
    },
    "The Void Sovereign": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Soberano do Vazio"
          }
        }
      }
    },
    "The Void Throne": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Trono do Vazio"
          }
        }
      }
    },
    "The Void Titan — HP and ATK scale with your current floor. Always dangerous.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Titã do Vazio — HP e ATQ escalam com seu andar atual. Sempre perigoso."
          }
        }
      }
    },
    "The Void Walker": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Andarilho do Vazio"
          }
        }
      }
    },
    "The Wall Crawler": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Rastejador das Paredes"
          }
        }
      }
    },
    "The Wall Crawler is canon. Something in the Walls lives on in our hearts.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Rastejador das Paredes é canônico. Algo nas Paredes vive em nossos corações."
          }
        }
      }
    },
    "The Watcher — does not attack but gets 50% stronger every round. You must go aggressive.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Observador — não ataca mas fica 50% mais forte a cada rodada. Você precisa ser agressivo."
          }
        }
      }
    },
    "The Weeping Bark": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Casca Chorosa"
          }
        }
      }
    },
    "The Weeping Child": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Criança Chorosa"
          }
        }
      }
    },
    "The Weeping Child attacks! It is small but it is furious.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Criança Chorosa ataca! É pequena, mas está furiosa."
          }
        }
      }
    },
    "The Weeping Child has been there longest. Long enough that nobody remembers what she was called before she became what she is. The Weeping Mother arrived later, looking for something she lost. She has not found it. She has been there long enough now that she is not sure she would know what to do if she did. The house is patient. The house has always been patient. It has nowhere to be.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Criança Chorosa está lá há mais tempo. Tempo suficiente para que ninguém lembre como ela era chamada antes de se tornar o que é. A Mãe Chorosa chegou depois, procurando algo que perdeu. Ela não encontrou. Já está lá há tanto tempo que não tem certeza se saberia o que fazer se encontrasse. A casa é paciente. A casa sempre foi paciente. Ela não tem para onde ir."
          }
        }
      }
    },
    "The Weeping Child is in the game. The raid exploit is blocked. We are not cooked.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Criança Chorosa está no jogo. O exploit de missão está bloqueado. Nós não estamos ferrados."
          }
        }
      }
    },
    "The Weeping Child — unique encounter with soothe mechanic. Pick it up or hum a lullaby. 60-65% success. Failure triggers combat.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Criança Chorosa — encontro único com mecânica de acalmar. Pegue-a no colo ou cante uma canção de ninar. 60-65% de sucesso. Falha dispara combate."
          }
        }
      }
    },
    "The Weeping Child, Music Box, and Oldest Guest each have their own death lines in The Hollow.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Criança Chorosa, a Caixa de Música e o Hóspede Mais Antigo cada um tem suas próprias frases de morte no Vazio."
          }
        }
      }
    },
    "The Weeping Mother": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Mãe Chorosa"
          }
        }
      }
    },
    "The Weeping Mother attacks. She is not angry. She is simply looking for something and you are in the way.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Mãe Chorosa ataca. Ela não está com raiva. Ela está simplesmente procurando algo e você está no caminho."
          }
        }
      }
    },
    "The Weeping Mother — new special encounter in The Hollow, floors 5 and above": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Mãe Chorosa — novo encontro especial no Vazio, andares 5 e além"
          }
        }
      }
    },
    "The Weeping Mother. She is searching for her child. You did not find the child. Two options: do a chore for her, or fight her. She hits very hard.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Mãe Chorosa. Ela está procurando por seu filho. Você não encontrou a criança. Duas opções: fazer uma tarefa para ela, ou lutar contra ela. Ela bate muito forte."
          }
        }
      }
    },
    "The Weeping Mother. She is searching for her child. You soothed the child earlier this run. You can lead her to it. Or you can fight her. She is very strong.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Mãe Chorosa. Ela está procurando por seu filho. Você acalmou a criança antes nesta partida. Você pode levá-la até ela. Ou pode lutar contra ela. Ela é muito forte."
          }
        }
      }
    },
    "The Whispering Forest": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Floresta dos Sussurros"
          }
        }
      }
    },
    "The Whispering Forest lore": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "História da Floresta dos Sussurros"
          }
        }
      }
    },
    "The Whispering Forest — Dungeon 6": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Floresta dos Sussurros — Masmorra 6"
          }
        }
      }
    },
    "The Whispering Forest, locked, cursed forest dungeon, complete The Hollow to unlock": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Floresta dos Sussurros, bloqueado, masmorra de floresta amaldiçoada, complete O Vazio para desbloquear"
          }
        }
      }
    },
    "The Witness": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Testemunha"
          }
        }
      }
    },
    "The Witness added to your minions.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Testemunha adicionada aos seus lacaios."
          }
        }
      }
    },
    "The World": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mundo"
          }
        }
      }
    },
    "The World Update": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Atualização Mundial"
          }
        }
      }
    },
    "The abyss is completely still. Even the ice makes no sound.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O abismo está completamente quieto. Até o gelo não faz som."
          }
        }
      }
    },
    "The abyss is perfectly still. Not even the creatures stir.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O abismo está perfeitamente quieto. Nem mesmo as criaturas se movem."
          }
        }
      }
    },
    "The abyss itself answers to it. The abyss has been answering for a very long time.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O próprio abismo lhe responde. O abismo vem respondendo há muito tempo."
          }
        }
      }
    },
    "The abyss speaks. Listen to the three beats. Then tap the button three times to match the same rhythm.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O abismo fala. Escute as três batidas. Depois toque o botão três vezes para acompanhar o mesmo ritmo."
          }
        }
      }
    },
    "The air burns your lungs. Every step costs more.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ar queima seus pulmões. Cada passo custa mais."
          }
        }
      }
    },
    "The alpha undead hound. Drains SP from fallen enemies.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cão morto-vivo alfa. Drena SP de inimigos caídos."
          }
        }
      }
    },
    "The apex of the ocean. Three phases — Surfacing, Rage, and the Deep Pull. In phase 3 every turn it survives it hits harder. You do not have long.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ápice do oceano. Três fases — Emersão, Fúria e a Puxada Profunda. Na fase 3, a cada turno que sobrevive, bate mais forte. Você não tem muito tempo."
          }
        }
      }
    },
    "The archives held secrets older than memory. Now they are yours.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos guardavam segredos mais antigos que a memória. Agora são seus."
          }
        }
      }
    },
    "The armor and the soldier fused in the moment of the disaster. Neither survived. Both are still here. It fights because that is what soldiers do.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A armadura e o soldado se fundiram no momento do desastre. Nenhum dos dois sobreviveu. Ambos ainda estão aqui. Luta porque é isso que soldados fazem."
          }
        }
      }
    },
    "The armor was abandoned in the flooding. Something moved in. It fits perfectly.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A armadura foi abandonada na inundação. Algo se instalou nela. Serve perfeitamente."
          }
        }
      }
    },
    "The bats of this place survived by eating ash for generations. They are not what bats should be anymore. Their wings leave burn marks on what they touch.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os morcegos deste lugar sobreviveram comendo cinza por gerações. Não são mais o que morcegos deveriam ser. Suas asas deixam marcas de queimadura no que tocam."
          }
        }
      }
    },
    "The bed is yours. Rest here to fully restore HP and SP.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cama é sua. Descanse aqui para restaurar totalmente HP e SP."
          }
        }
      }
    },
    "The bell has not stopped ringing since the house was abandoned. Nobody is sure what it is calling.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sino não parou de tocar desde que a casa foi abandonada. Ninguém tem certeza do que ele está chamando."
          }
        }
      }
    },
    "The bell rings. Your turn is lost.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sino toca. Seu turno é perdido."
          }
        }
      }
    },
    "The books are perfectly preserved. The archivists who stayed are perfectly preserved. The thing that caused all of this is still down there, in the deepest chamber, surrounded by the collected knowledge of a civilization it ended. Explorers who descend report that the water is perfectly still. That the candles are still lit. That something has been marking certain pages. That the marks are in a language that did not exist before the flooding and has not been seen anywhere since. The Archives are still cataloguing. They have simply changed what they consider worth keeping.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os livros estão perfeitamente preservados. Os arquivistas que ficaram estão perfeitamente preservados. A coisa que causou tudo isso ainda está lá embaixo, na câmara mais profunda, rodeada pelo conhecimento coletado de uma civilização que ela terminou. Exploradores que descem relatam que a água está perfeitamente quieta. Que as velas ainda estão acesas. Que algo tem marcado certas páginas. Que as marcas estão em uma língua que não existia antes da inundação e não foi vista em nenhum outro lugar desde então. Os Arquivos ainda estão catalogando. Eles simplesmente mudaram o que consideram valer a pena manter."
          }
        }
      }
    },
    "The boss appears on floor 7 instead of 10.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O chefe aparece no andar 7 em vez do 10."
          }
        }
      }
    },
    "The boss defeat victory sound": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O som de vitória ao derrotar um chefe"
          }
        }
      }
    },
    "The boss got angrier. You got a trophy. Fair trade.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O chefe ficou mais irritado. Você ganhou um troféu. Troca justa."
          }
        }
      }
    },
    "The boss on floor 10 has 3 phases. Each phase it gets stronger and changes its attack pattern. Defeat all 3 phases to complete the dungeon.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O chefe no andar 10 tem 3 fases. Em cada fase ele fica mais forte e muda seu padrão de ataque. Derrote as 3 fases para completar a masmorra."
          }
        }
      }
    },
    "The bottom of the ocean where no light reaches. Ancient creatures have waited for you.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O fundo do oceano onde nenhuma luz alcança. Criaturas ancestrais esperaram por você."
          }
        }
      }
    },
    "The bottom of the ocean where no light reaches. Unlocks automatically after completing The Infernal Descent. Features 9 unique ocean enemies — Tide Wraith, Drowned Sailor, Ink Fiend, Deep Stalker, Siren, Abyssal Eye and more, each with unique combat mechanics. The Leviathan is the final boss with 4 phases and 800 HP — the hardest boss in the game. Each phase transition plays a different music track. Has 5 unique dungeon events including The Witness — a shark that has been watching you the entire run and becomes your permanent minion if you earn its trust. Has its own weather system, music, and ambient. Bring everything you have.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O fundo do oceano onde nenhuma luz alcança. Desbloqueia automaticamente após completar A Descida Infernal. Apresenta 9 inimigos oceânicos únicos — Espectro da Maré, Marinheiro Afogado, Demônio de Tinta, Perseguidor das Profundezas, Sereia, Olho Abissal e mais, cada um com mecânicas de combate únicas. O Leviatã é o chefe final com 4 fases e 800 HP — o chefe mais difícil do jogo. Cada transição de fase toca uma faixa musical diferente. Tem 5 eventos únicos de masmorra incluindo A Testemunha — um tubarão que observa você durante toda a partida e se torna seu servo permanente se você ganhar sua confiança. Tem seu próprio sistema de clima, música e ambiente. Traga tudo que você tem."
          }
        }
      }
    },
    "The caiman. Massive defense. Slow but devastating.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O jacaré. Defesa massiva. Lento mas devastador."
          }
        }
      }
    },
    "The call came. You answered.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O chamado veio. Você respondeu."
          }
        }
      }
    },
    "The characters were not broken during this audit. This is noted as an improvement.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os personagens não foram quebrados durante esta auditoria. Isso é notado como uma melhoria."
          }
        }
      }
    },
    "The chosen of a forgotten god.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O escolhido de um deus esquecido."
          }
        }
      }
    },
    "The chosen of a forgotten god. Enrages at 50% HP.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O escolhido de um deus esquecido. Enfurece-se aos 50% de HP."
          }
        }
      }
    },
    "The city of Vel Ashara was the greatest trading hub in the old world. It sat at the base of a dormant volcano that had not erupted in four hundred years. The city grew rich. Its people grew comfortable. The volcano was not dormant. It was thinking. On the night of the Burning, every fire in Vel Ashara went out at the same moment — and then everything caught fire at once. The city was swallowed in six hours. Something in the fire that consumed Vel Ashara was different from ordinary fire. It did not go out when there was nothing left to burn. It is still there now, three centuries later, burning the same ash it has been burning since the collapse. Explorers call the ruins the Ashbound Wastes. The locals, the few who remain in the hills above, call it by its older name: The Place The Fire Remembers.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cidade de Vel Ashara era o maior centro comercial do mundo antigo. Ficava na base de um vulcão dormente que não entrava em erupção há quatrocentos anos. A cidade enriqueceu. Seu povo ficou confortável. O vulcão não estava dormente. Estava pensando. Na noite do Incêndio, todo fogo em Vel Ashara se apagou no mesmo momento — e então tudo pegou fogo de uma vez. A cidade foi engolida em seis horas. Algo no fogo que consumiu Vel Ashara era diferente do fogo comum. Não se apagou quando não havia mais nada para queimar. Ainda está lá agora, três séculos depois, queimando as mesmas cinzas que queima desde o colapso. Exploradores chamam as ruínas de Terras Cinzentas. Os locais, os poucos que permanecem nas colinas acima, a chamam pelo seu nome mais antigo: O Lugar Que o Fogo Lembra."
          }
        }
      }
    },
    "The clock begins.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O relógio começa."
          }
        }
      }
    },
    "The clock endures. Another cycle begins.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O relógio persiste. Outro ciclo começa."
          }
        }
      }
    },
    "The clock pauses. Your turn. Attack precisely.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O relógio pausa. Seu turno. Ataque com precisão."
          }
        }
      }
    },
    "The clock pauses. Your turn. This enemy is no joke. Heavy strike may miss.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O relógio pausa. Seu turno. Este inimigo não é brincadeira. O golpe pesado pode errar."
          }
        }
      }
    },
    "The cold is not a temperature here. It is a living thing that has waited for something warm to arrive for a thousand years. Now something warm has arrived.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O frio aqui não é uma temperatura. É uma coisa viva que esperou mil anos por algo quente chegar. Agora algo quente chegou."
          }
        }
      }
    },
    "The cold preserves things. Including things that should not be preserved.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O frio preserva coisas. Inclusive coisas que não deveriam ser preservadas."
          }
        }
      }
    },
    "The cold tried to stop you. It failed.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O frio tentou te parar. Falhou."
          }
        }
      }
    },
    "The concentrated will of a thousand unfinished manuscripts. It wants to be completed.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A vontade concentrada de mil manuscritos inacabados. Quer ser completado."
          }
        }
      }
    },
    "The corruption consumes you. The forest claims another soul.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A corrupção te consome. A floresta reivindica outra alma."
          }
        }
      }
    },
    "The corruption found her in the Hollow. It followed her here.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A corrupção a encontrou no Vazio. Ela a seguiu até aqui."
          }
        }
      }
    },
    "The corruption made something terrible into something worse.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A corrupção transformou algo terrível em algo pior."
          }
        }
      }
    },
    "The corruption needed something large.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A corrupção precisava de algo grande."
          }
        }
      }
    },
    "The crack widens. Minus 5 HP from the pressure.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A fenda se expande. Menos 5 HP pela pressão."
          }
        }
      }
    },
    "The creatures inside the forest did not come from anywhere. They grew there. This distinction matters to the scholars who study the forest from a very safe distance. Things that come from somewhere can be driven back. Things that grew somewhere are a different problem. The forest is not a place where dangerous things live. The forest is a place that produces dangerous things the way other forests produce leaves, continuously and without particular intention. It is not malicious. It is simply what it is. It has been what it is for a very long time. It will continue to be what it is long after everyone who has ever entered it has been forgotten.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As criaturas dentro da floresta não vieram de lugar nenhum. Cresceram lá. Essa distinção importa para os eruditos que estudam a floresta de uma distância bem segura. Coisas que vêm de algum lugar podem ser repelidas. Coisas que cresceram em algum lugar são um problema diferente. A floresta não é um lugar onde coisas perigosas vivem. A floresta é um lugar que produz coisas perigosas da mesma forma que outras florestas produzem folhas, continuamente e sem intenção particular. Não é maliciosa. É simplesmente o que é. Tem sido o que é por muito tempo. Vai continuar sendo o que é muito depois que todos que já entraram nela forem esquecidos."
          }
        }
      }
    },
    "The daily challenge answered. Come back tomorrow. The dungeon will be waiting.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O desafio diário respondido. Volte amanhã. A masmorra estará esperando."
          }
        }
      }
    },
    "The dark twin of the Leprechaun. Drunk on cursed ale. Hits harder every turn.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O gêmeo sombrio do Duende. Embriagado de cerveja amaldiçoada. Bate mais forte a cada turno."
          }
        }
      }
    },
    "The darkness at this depth is not an absence of light. It is a substance. This creature is made of it. It is very comfortable here.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A escuridão nesta profundidade não é ausência de luz. É uma substância. Essa criatura é feita dela. Está muito confortável aqui."
          }
        }
      }
    },
    "The darkness here is different from other darknesses. The bats that live in it have changed accordingly. They do not avoid the cold. They carry it.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A escuridão aqui é diferente de outras escuridões. Os morcegos que vivem nela mudaram de acordo. Não evitam o frio. Eles o carregam."
          }
        }
      }
    },
    "The darkness remembers you.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A escuridão lembra de você."
          }
        }
      }
    },
    "The dead are particularly restless tonight.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os mortos estão particularmente inquietos esta noite."
          }
        }
      }
    },
    "The deepest creature in the deepest dungeon. Yours now.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A criatura mais profunda na masmorra mais profunda. Sua agora."
          }
        }
      }
    },
    "The deepest dungeon cleared. Whatever lives in the deep knows your name now.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A masmorra mais profunda concluída. O que quer que viva nas profundezas sabe seu nome agora."
          }
        }
      }
    },
    "The deepest dungeon. The hardest boss. The Leviathan is not here to play. 800 HP. Four phases. It hits harder than anything you have faced. Bring everything you have. You will need it.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A masmorra mais profunda. O chefe mais difícil. O Leviatã não veio para brincar. 800 HP. Quatro fases. Ele bate mais forte do que qualquer coisa que você já enfrentou. Traga tudo que você tem. Você vai precisar."
          }
        }
      }
    },
    "The deepest fire. A dungeon of pure void and flame only the strongest reach.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O fogo mais profundo. Uma masmorra de vazio e chama pura que apenas os mais fortes alcançam."
          }
        }
      }
    },
    "The default achievement chime": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O som padrão de conquista"
          }
        }
      }
    },
    "The dungeon IS the Architect. You have been inside it the whole time.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A masmorra É o Arquiteto. Você esteve dentro dela o tempo todo."
          }
        }
      }
    },
    "The dungeon IS the Architect. You have been inside it the whole time. It built this place specifically for you. It has been waiting.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A masmorra É o Arquiteto. Você esteve dentro dele o tempo todo. Ele construiu este lugar especificamente para você. Estava esperando."
          }
        }
      }
    },
    "The dungeon claims another soul.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A masmorra reivindica outra alma."
          }
        }
      }
    },
    "The dungeon does not play fair at this level. Neither should you.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A masmorra não joga limpo neste nível. Você também não deveria."
          }
        }
      }
    },
    "The dungeon has": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A masmorra tem"
          }
        }
      }
    },
    "The dungeon has been conquered. What will you do?": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A masmorra foi conquistada. O que você vai fazer?"
          }
        }
      }
    },
    "The dungeon has no end. Leave it running. See how far you fall.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A masmorra não tem fim. Deixe rodando. Veja o quão longe você cai."
          }
        }
      }
    },
    "The dungeon is alive. It always was.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A masmorra está viva. Sempre esteve."
          }
        }
      }
    },
    "The dungeon never ends. No floor 10. No victory. Just how deep can you go? Your deepest floor is saved as your personal record.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A masmorra nunca termina. Sem andar 10. Sem vitória. Apenas o quão profundo você pode ir? Seu andar mais profundo é salvo como seu recorde pessoal."
          }
        }
      }
    },
    "The dungeon owes someone money. You are here to collect.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A masmorra deve dinheiro a alguém. Você está aqui para cobrar."
          }
        }
      }
    },
    "The dungeon refuses to speak of this. Face it in Nightmare Mode to reveal the truth.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A masmorra se recusa a falar sobre isso. Enfrente-a no Modo Pesadelo para revelar a verdade."
          }
        }
      }
    },
    "The dungeon remembers what you forget.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A masmorra lembra o que você esquece."
          }
        }
      }
    },
    "The dungeon remembers you returned. It rewards consistency.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A masmorra lembra que você voltou. Ela recompensa a consistência."
          }
        }
      }
    },
    "The dungeon twists into something seasonal. Old enemies wear new faces. New enemies wear old bones.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A masmorra se transforma em algo sazonal. Inimigos antigos usam rostos novos. Inimigos novos usam ossos antigos."
          }
        }
      }
    },
    "The dungeon twists into something wrong. Enemies that exist nowhere else. The boss has never been seen before.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A masmorra se retorce em algo errado. Inimigos que não existem em nenhum outro lugar. O chefe nunca foi visto antes."
          }
        }
      }
    },
    "The dungeon will remember your cowardice.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A masmorra vai lembrar da sua covardia."
          }
        }
      }
    },
    "The eagle is silent. The cry fades.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A águia fica em silêncio. O grito se dissipa."
          }
        }
      }
    },
    "The echo of a violent death, given form. It does not attack you. It shares its final moments with you, over and over, until you break.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O eco de uma morte violenta, tomando forma. Não ataca você. Compartilha seus momentos finais com você, repetidas vezes, até que você quebre."
          }
        }
      }
    },
    "The enemy struggles against the roots, unable to strike back.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O inimigo luta contra as raízes, incapaz de contra-atacar."
          }
        }
      }
    },
    "The essence of an Ash Titan. Burns with eternal fury.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A essência de um Titã de Cinzas. Arde com furia eterna."
          }
        }
      }
    },
    "The fallen. Your deaths and those of players worldwide.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os caídos. Suas mortes e as de jogadores do mundo todo."
          }
        }
      }
    },
    "The fire did not just burn this creature. It became this creature.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O fogo não apenas queimou esta criatura. Ele se tornou esta criatura."
          }
        }
      }
    },
    "The fire that destroyed the city was never extinguished. Over centuries it became aware. It does not want to hurt you. It simply wants to share what it is. What it is, is burning.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O fogo que destruiu a cidade nunca foi extinto. Ao longo dos séculos, ganhou consciência. Não quer machucar você. Só quer compartilhar o que é. E o que é, é fogo."
          }
        }
      }
    },
    "The fireworks are reloading. Wait a moment.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os fogos de artifício estão recarregando. Espere um momento."
          }
        }
      }
    },
    "The first blow glances off. Always. It has been hit before. It has learned from being hit. Your first strike teaches it nothing.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O primeiro golpe sempre resvala. Sempre. Já foi atingido antes. Aprendeu com isso. Seu primeiro golpe não lhe ensina nada."
          }
        }
      }
    },
    "The first blow glances off. The second does not.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O primeiro golpe resvala. O segundo não."
          }
        }
      }
    },
    "The first door will not open itself. It never has.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A primeira porta não se abre sozinha. Nunca se abriu."
          }
        }
      }
    },
    "The first dungeon existed long before you. Now you know why.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A primeira masmorra existia muito antes de você. Agora você sabe por quê."
          }
        }
      }
    },
    "The first dungeon. A thousand-year-old crypt ruled by the Undying King, Malachar. Undead enemies — skeletons, ghosts, wraiths. Standard dungeon mechanics. Recommended for all new players. The boss Malachar has three phases and summons adds in the final phase.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A primeira masmorra. Uma cripta milenar governada pelo Rei Imortal, Malachar. Inimigos mortos-vivos — esqueletos, fantasmas, espectros. Mecânicas de masmorra padrão. Recomendada para todos os novos jogadores. O chefe Malachar tem três fases e convoca reforços na fase final."
          }
        }
      }
    },
    "The first hit does nothing. It has learned to absorb the opening blow.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O primeiro golpe não faz nada. Aprendeu a absorver o golpe inicial."
          }
        }
      }
    },
    "The first thing you face. Held together by something older than bone.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A primeira coisa que você enfrenta. Mantido unido por algo mais antigo que osso."
          }
        }
      }
    },
    "The first week of each month. You hit harder. You also take more hits. The moon does not care about fairness.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A primeira semana de cada mês. Você bate mais forte. Você também recebe mais golpes. A lua não se importa com justiça."
          }
        }
      }
    },
    "The floor is treacherous. One wrong step.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O chão é traiçoeiro. Um passo errado."
          }
        }
      }
    },
    "The fog has opinions. This is new.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A névoa tem opiniões. Isso é novo."
          }
        }
      }
    },
    "The forest built it specifically to deal with intruders. Your first strike teaches it nothing.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A floresta o construiu especificamente para lidar com intrusos. Seu primeiro golpe não ensina nada a ele."
          }
        }
      }
    },
    "The forest built it to deal with intruders. The forest is not subtle about what it considers an intruder.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A floresta o construiu para lidar com intrusos. A floresta não é sutil sobre o que considera um intruso."
          }
        }
      }
    },
    "The forest chooses to protect you tonight. The whispers are kind.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A floresta escolhe te proteger esta noite. Os sussurros são gentis."
          }
        }
      }
    },
    "The forest closes its canopy. No light reaches the floor.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A floresta fecha sua copa. Nenhuma luz alcança o chão."
          }
        }
      }
    },
    "The forest has always been there. This is the first thing the people who live near its edge will tell you, and they will say it with a particular tone — not pride, not fear, but the flat certainty of someone describing a fact they have long since stopped trying to explain. The forest was there before the villages. Before the roads. Before anyone thought to draw a map of this region. The trees are old in a way that old trees are not usually old. They do not look ancient. They look permanent.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A floresta sempre esteve lá. Essa é a primeira coisa que as pessoas que vivem perto de sua borda vão te dizer, e vão dizer com um tom particular — não orgulho, não medo, mas a certeza plana de alguém descrevendo um fato que há muito desistiu de tentar explicar. A floresta estava lá antes das vilas. Antes das estradas. Antes de alguém pensar em desenhar um mapa desta região. As árvores são antigas de um jeito que árvores antigas normalmente não são. Não parecem ancestrais. Parecem permanentes."
          }
        }
      }
    },
    "The forest made its own Chimera. Three parts, each wrong in a different way. Only appears on floor 9 of the Whispering Forest.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A floresta criou sua própria Quimera. Três partes, cada uma errada de um jeito diferente. Só aparece no andar 9 da Floresta dos Sussurros."
          }
        }
      }
    },
    "The forest walks. This is one of its feet. There are others.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A floresta caminha. Este é um de seus pés. Há outros."
          }
        }
      }
    },
    "The forest whispered warnings the entire way. You ignored every one.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A floresta sussurrou avisos o caminho todo. Você ignorou todos."
          }
        }
      }
    },
    "The game is now fully translated into Portuguese.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O jogo agora está totalmente traduzido para o português."
          }
        }
      }
    },
    "The gate is sealed. Two paths lead to its opening. Choose your trial.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O portão está selado. Dois caminhos levam à sua abertura. Escolha seu desafio."
          }
        }
      }
    },
    "The gaze never comes.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O olhar nunca vem."
          }
        }
      }
    },
    "The ghost of a drowned archivist. Knows every weakness.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O fantasma de um arquivista afogado. Conhece toda fraqueza."
          }
        }
      }
    },
    "The ghost of a miner who loved their job too much to leave it. Still working. The sound of their pickaxe echoes through levels they no longer inhabit.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O fantasma de um mineiro que amava demais o trabalho para deixá-lo. Ainda trabalhando. O som de sua picareta ecoa por níveis que ele não habita mais."
          }
        }
      }
    },
    "The ghost of a miner who went too deep and did not come back up. It wanders the lower tunnels carrying a pickaxe it no longer needs, looking for a way out it can never find.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O fantasma de um mineiro que foi longe demais e não voltou. Ele vagueia pelos túneis inferiores carregando uma picareta que não precisa mais, procurando uma saída que nunca vai encontrar."
          }
        }
      }
    },
    "The ghost of a researcher who cannot remember what they were researching. Still looking.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O fantasma de um pesquisador que não consegue lembrar o que pesquisava. Ainda procurando."
          }
        }
      }
    },
    "The ghost of someone who came looking for a specific book. Never found it. Never left.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O fantasma de alguém que veio procurar um livro específico. Nunca o encontrou. Nunca partiu."
          }
        }
      }
    },
    "The god of guns. 8 shots before reload. Highest damage in the game. Extremely rare.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O deus das armas. 8 tiros antes de recarregar. Maior dano do jogo. Extremamente rara."
          }
        }
      }
    },
    "The greatest library ever built now sits under three hundred feet of dark water. The books are perfectly preserved. The archivists who refused to leave are also perfectly preserved. They have had a very long time to read everything. They did not like what they found.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A maior biblioteca já construída agora fica sob trezentos pés de água escura. Os livros estão perfeitamente preservados. Os arquivistas que se recusaram a partir também estão perfeitamente preservados. Eles tiveram muito tempo para ler tudo. Não gostaram do que encontraram."
          }
        }
      }
    },
    "The guard dogs of the descent. Bred for loyalty to whatever owns this place. Extremely loyal. Extremely hungry.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os cães de guarda da descida. Criados para lealdade a quem for que possua este lugar. Extremamente leais. Extremamente famintos."
          }
        }
      }
    },
    "The harvest failed. Something in the cornfield is angry about it. Eight new enemies have entered the dungeon and they are hungry.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A colheita falhou. Algo no campo de milho está furioso com isso. Oito novos inimigos entraram na masmorra e estão com fome."
          }
        }
      }
    },
    "The heroes did what few have managed. The dungeon is silent.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os heróis fizeram o que poucos conseguiram. A masmorra está silenciosa."
          }
        }
      }
    },
    "The higher it climbs, the hungrier it gets. It heals on every strike.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto mais alto sobe, mais faminto fica. Cura-se a cada golpe."
          }
        }
      }
    },
    "The hollow was empty of everything except danger. You filled it with victory.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cova estava vazia de tudo, exceto perigo. Você a preencheu com vitória."
          }
        }
      }
    },
    "The house is not a location. It has decided you are staying.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A casa não é um lugar. Ela decidiu que você vai ficar."
          }
        }
      }
    },
    "The house is not haunted in the traditional sense. Haunted implies that something from outside came in and stayed. The Hollow is different. The Hollow is the kind of place where things that enter do not leave, but the house does not take them. They simply find, after a while, that they no longer want to go. The difference matters. The house has never forced anyone to stay. It has simply made staying feel more reasonable than leaving. One room at a time. One day at a time. Until leaving is a thing that happens to other people.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A casa não é assombrada no sentido tradicional. Assombrada implica que algo de fora entrou e ficou. O Vazio é diferente. O Vazio é o tipo de lugar onde as coisas que entram não saem, mas a casa não as toma. Elas simplesmente percebem, depois de um tempo, que não querem mais ir. A diferença importa. A casa nunca forçou ninguém a ficar. Ela simplesmente fez ficar parecer mais razoável do que ir. Uma sala por vez. Um dia por vez. Até que ir se torne algo que acontece com outras pessoas."
          }
        }
      }
    },
    "The hunt ends — triple attack and crit guaranteed.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A caça termina — ataque triplicado e crítico garantido."
          }
        }
      }
    },
    "The hunter is almost here. Choose: Fight the hunter, or Run and sprint away.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O caçador está quase aqui. Escolha: Lutar contra o caçador, ou Correr e fugir."
          }
        }
      }
    },
    "The hunter is almost here. Fight or run?": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O caçador está quase chegando. Lutar ou fugir?"
          }
        }
      }
    },
    "The ice encasing him cracks when he is angry. He is always angry. The ice is always cracking.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O gelo que o envolve racha quando ele fica com raiva. Ele está sempre com raiva. O gelo está sempre rachando."
          }
        }
      }
    },
    "The infernal descent tried to break your spirit. It miscalculated.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A descida infernal tentou quebrar seu espírito. Calculou errado."
          }
        }
      }
    },
    "The internal firing component.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O componente interno de disparo."
          }
        }
      }
    },
    "The inventory has a search bar at the top — type any item name to filter instantly. Tap the star button on any item to add it to favorites — favorited items always appear at the top of your inventory. Tap the sort button (⇅) to auto-sort everything by type — favorites first, then weapons, armor, potions, and materials.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O inventário tem uma barra de busca no topo — digite qualquer nome de item para filtrar instantaneamente. Toque no botão de estrela em qualquer item para adicioná-lo aos favoritos — itens favoritados sempre aparecem no topo do seu inventário. Toque no botão de organizar (⇅) para organizar tudo automaticamente por tipo — favoritos primeiro, depois armas, armaduras, poções e materiais."
          }
        }
      }
    },
    "The jaguar. Fast, agile, 20% dodge chance. The rainforest's apex predator.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A onça. Rápida, ágil, 20% de chance de esquiva. O predador supremo da floresta tropical."
          }
        }
      }
    },
    "The key is momentum — never idle. Kill enemies fast and keep moving. Use floor transitions strategically — advancing to the next floor resets the hunter distance slightly. Fight the hunter only at level 8 or above. Before the fight make sure you have full HP and at least 1 potion. When choosing between Fight and Run — if you have a strong skill ready, fight. If your HP is below 50 percent, run.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave é o momentum — nunca fique parado. Mate inimigos rápido e continue se movendo. Use transições de andar estrategicamente — avançar para o próximo andar reinicia um pouco a distância do caçador. Lute contra o caçador apenas no nível 8 ou acima. Antes da luta certifique-se de ter HP completo e pelo menos 1 poção. Ao escolher entre Lutar e Correr — se você tem uma habilidade forte pronta, lute. Se seu HP está abaixo de 50 por cento, corra."
          }
        }
      }
    },
    "The largest spider in the Crypt. It has been here long enough to web entire corridors. Some of the things caught in those webs are still alive. They wish they were not.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A maior aranha da Cripta. Está aqui há tempo suficiente para tecer corredores inteiros. Algumas das coisas presas naquelas teias ainda estão vivas. Elas gostariam de não estar."
          }
        }
      }
    },
    "The largest thing in the Wastes. It was built from everything the fire left behind that was too dense to become ash. It is not alive. It does not need to be.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A maior coisa nas Terras Cinzentas. Foi construído com tudo que o fogo deixou para trás que era denso demais para virar cinza. Não está vivo. Não precisa estar."
          }
        }
      }
    },
    "The last king of the crypt. Still ruling. The kingdom is gone but the throne is not.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O último rei da cripta. Ainda governa. O reino se foi, mas o trono não."
          }
        }
      }
    },
    "The last note played. You were still standing when it did.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A última nota tocada. Você ainda estava de pé quando isso aconteceu."
          }
        }
      }
    },
    "The last pact — sacrifice all HP above 1 for massive damage.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O último pacto — sacrifique todo o HP acima de 1 por dano massivo."
          }
        }
      }
    },
    "The lower the HP, the harder the hits. Below 25% HP becomes truly unstoppable.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto menor o HP, mais forte os golpes. Abaixo de 25% de HP se torna verdadeiramente imparável."
          }
        }
      }
    },
    "The lower your HP the harder you hit. At 25% HP you deal double damage.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto menor seu HP, mais forte você bate. Com 25% de HP você causa dano dobrado."
          }
        }
      }
    },
    "The main attraction is still in the deepest chamber. These are just its thoughts.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A atração principal ainda está na câmara mais profunda. Estes são apenas seus pensamentos."
          }
        }
      }
    },
    "The melody ends. Your turn.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A melodia termina. Seu turno."
          }
        }
      }
    },
    "The melody plays. You cannot act.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A melodia toca. Você não pode agir."
          }
        }
      }
    },
    "The messages stop. Your turn returns.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As mensagens param. Seu turno retorna."
          }
        }
      }
    },
    "The mine rats are blind. They have been blind for generations. They navigate by vibration — the scrape of a pickaxe, the shift of a boot on loose stone. They find you before you find them.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ratos da mina são cegos. São cegos há gerações. Navegam por vibração — o raspar de uma picareta, o deslocar de uma bota em pedra solta. Eles te encontram antes que você os encontre."
          }
        }
      }
    },
    "The mirror is broken. Whatever it showed — it cannot haunt you now.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O espelho está quebrado. O que quer que mostrasse — não pode mais te assombrar."
          }
        }
      }
    },
    "The mirror shatters and the shards cut you. 1 corruption stack added.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O espelho se estilhaça e os fragmentos te cortam. 1 carga de corrupção adicionada."
          }
        }
      }
    },
    "The more HP you lose the more damage you deal. No cap. Pure rage.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto mais HP você perde, mais dano você causa. Sem limite. Furia pura."
          }
        }
      }
    },
    "The most corrupted thing in the forest that can still fight. It barely counts as a person anymore.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A coisa mais corrompida da floresta que ainda consegue lutar. Mal ainda conta como pessoa."
          }
        }
      }
    },
    "The most senior librarian. Has read everything. Is not at peace with what it learned.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O bibliotecário mais antigo. Já leu tudo. Não fez as pazes com o que aprendeu."
          }
        }
      }
    },
    "The mountain itself has decided you have gone far enough. It pulled itself together into something with arms and a bad attitude. It is not a metaphor. It is literally the mountain.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A própria montanha decidiu que você já foi longe demais. Ela se reuniu em algo com braços e má atitude. Não é uma metáfora. É literalmente a montanha."
          }
        }
      }
    },
    "The obituary is empty. No one has fallen yet.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O obituário está vazio. Ninguém caiu ainda."
          }
        }
      }
    },
    "The ocean above the Abyssal Deep has no name on any map. Sailors who have crossed it do not speak of it afterward. Not from trauma — they simply find, on returning to port, that they have nothing to say. The crossing was uneventful. The water was dark. Something large moved beneath the surface at a distance that made estimation impossible. They arrived. This is the complete account of every sailor who has crossed those waters. The absence of detail is itself the detail.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O oceano sobre as Profundezas Abissais não tem nome em nenhum mapa. Marinheiros que o cruzaram não falam sobre isso depois. Não por trauma — eles simplesmente percebem, ao retornar ao porto, que não têm nada a dizer. A travessia foi tranquila. A água estava escura. Algo grande se moveu abaixo da superfície a uma distância que tornava a estimativa impossível. Eles chegaram. Este é o relato completo de todo marinheiro que já cruzou essas águas. A ausência de detalhes é em si o detalhe."
          }
        }
      }
    },
    "The offering contained 80 gold.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A oferenda continha 80 de ouro."
          }
        }
      }
    },
    "The offering was empty. Taking it added 2 corruption stacks.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A oferenda estava vazia. Pegá-la adicionou 2 cargas de corrupção."
          }
        }
      }
    },
    "The oldest dead. Their bones should have turned to dust long ago. Something in this place refuses to let them rest.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os mortos mais antigos. Seus ossos já deveriam ter virado pó há muito tempo. Algo neste lugar se recusa a deixá-los descansar."
          }
        }
      }
    },
    "The oldest thing in the forest. It was here before the village. It will be here after you.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A coisa mais antiga da floresta. Estava aqui antes da vila. Estará aqui depois de você."
          }
        }
      }
    },
    "The oldest tree in the forest. It remembers the witch. It approved of her work.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A árvore mais antiga da floresta. Lembra-se da bruxa. Aprovava o trabalho dela."
          }
        }
      }
    },
    "The one who hunts. Relentless. Unstoppable. Or so it thought.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquele que caça. Implacável. Imparável. Ou assim pensava."
          }
        }
      }
    },
    "The origin of every spider in the Crypt. She has been laying eggs in the dark for two hundred years. She is very protective of her children. She has a great many children.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A origem de cada aranha na Cripta. Vem pondo ovos na escuridão há duzentos anos. É muito protetora com seus filhos. Ela tem uma quantidade enorme de filhos."
          }
        }
      }
    },
    "The original curator refused to leave when the flooding started. The flooding started three hundred years ago.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O curador original se recusou a sair quando a inundação começou. A inundação começou há trezentos anos."
          }
        }
      }
    },
    "The original experience": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A experiência original"
          }
        }
      }
    },
    "The original. What the Soul Harvesters of the regular dungeon are pale imitations of. It has been collecting for longer than the dungeon has existed.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O original. Aquilo de que os Colhedores de Alma da masmorra comum são pálidas imitações. Está colecionando há mais tempo do que a masmorra existe."
          }
        }
      }
    },
    "The pause menu shows your character name, current floor, dungeon and HP. Options are Resume, Save, Settings, Quests and Main Menu. Cannot be opened during combat.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O menu de pausa mostra o nome do seu personagem, andar atual, masmorra e HP. As opções são Continuar, Salvar, Configurações, Missões e Menu Principal. Não pode ser aberto durante o combate."
          }
        }
      }
    },
    "The petrification fades. Defense restored.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A petrificação se dissipa. Defesa restaurada."
          }
        }
      }
    },
    "The pink river dolphin of Amazonian legend. Enchants you with 30% chance to charm.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O boto rosa da lenda amazônica. Te encanta com 30% de chance."
          }
        }
      }
    },
    "The pinnacle of forged weapons.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O auge das armas forjadas."
          }
        }
      }
    },
    "The pressure at this depth is immense. Every room costs you.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pressão nesta profundidade é imensa. Cada sala custa algo."
          }
        }
      }
    },
    "The purest form of magic. No weapons, no armor — pure arcane force. Highest magic damage in the game. Extremely fragile.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A forma mais pura de magia. Sem armas, sem armadura — pura força arcana. O maior dano mágico do jogo. Extremamente frágil."
          }
        }
      }
    },
    "The rats of the nightmare do not have eyes. They do not need eyes. They see you through the part of you that is afraid.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ratos do pesadelo não têm olhos. Não precisam de olhos. Eles te veem através da parte de você que tem medo."
          }
        }
      }
    },
    "The real story. Behind the game. Behind everything.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A história real. Por trás do jogo. Por trás de tudo."
          }
        }
      }
    },
    "The remains of climbers who burned out before reaching the top. They drift upward still, out of habit.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os restos de escaladores que se consumiram antes de chegar ao topo. Ainda flutuam para cima, por hábito."
          }
        }
      }
    },
    "The remnant of a soul that burned away in grief. It wanders the crypt searching for something it cannot name, destroying anything that reminds it of what it lost.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O remanescente de uma alma que se consumiu em luto. Vaga pela cripta em busca de algo que não consegue nomear, destruindo tudo que a lembra do que perdeu."
          }
        }
      }
    },
    "The reunion ending is the most emotional moment in the game. We stand by this.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O final da reunião é o momento mais emocional do jogo. Nós mantemos essa afirmação."
          }
        }
      }
    },
    "The revolver's bigger, angrier brother. More damage, slightly longer cooldown. A serious weapon.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O irmão maior e mais irritado do revólver. Mais dano, recarga um pouco mais longa. Uma arma séria."
          }
        }
      }
    },
    "The roots shift when no one watches.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As raízes se movem quando ninguém está olhando."
          }
        }
      }
    },
    "The ruler of this place. It knows you are here.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O governante deste lugar. Ele sabe que você está aqui."
          }
        }
      }
    },
    "The scream does not hurt your ears. It hurts something deeper.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O grito não machuca seus ouvidos. Machuca algo mais profundo."
          }
        }
      }
    },
    "The second week of each month. Sponsored by the Department of Dungeon Descent Incorporated. The Department did not ask to be called the architect. The Department has accepted this.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A segunda semana de cada mês. Patrocinado pelo Departamento de Dungeon Descent Incorporado. O Departamento não pediu para ser chamado de arquiteto. O Departamento aceitou isso."
          }
        }
      }
    },
    "The shark that watched you from the beginning. It chose you.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tubarão que te observou desde o início. Ele te escolheu."
          }
        }
      }
    },
    "The shop does not appear.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A loja não aparece."
          }
        }
      }
    },
    "The shrine grants plus 3 ATK for this run.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O santuário concede mais 3 de ATQ nesta partida."
          }
        }
      }
    },
    "The shrine heals you for 30 HP.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O santuário te cura em 30 HP."
          }
        }
      }
    },
    "The shrine restores 20 HP.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O santuário restaura 20 HP."
          }
        }
      }
    },
    "The shrine restores 20 SP.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O santuário restaura 20 SP."
          }
        }
      }
    },
    "The shrine restores 8 SP.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O santuário restaura 8 SP."
          }
        }
      }
    },
    "The shrine sharpens your strikes. +2 attack.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O santuário afia seus golpes. +2 de ataque."
          }
        }
      }
    },
    "The shrine strengthens you. +2 defense.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O santuário te fortalece. +2 de defesa."
          }
        }
      }
    },
    "The sound arrives before it does. By the time you hear it, it is already too close.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O som chega antes dele. Quando você o ouve, ele já está perto demais."
          }
        }
      }
    },
    "The spirit of a fallen Death Knight. Powerful and relentless.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O espírito de um Cavaleiro da Morte caído. Poderoso e implacável."
          }
        }
      }
    },
    "The sword froze mid-swing and kept swinging. The wielder is long gone.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A espada congelou no meio do golpe e continuou golpeando. Quem a empunhava se foi há muito tempo."
          }
        }
      }
    },
    "The sword rusted. Then it came alive. Rust and all.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A espada enferrujou. Depois ganhou vida. Ferrugem e tudo."
          }
        }
      }
    },
    "The tournament had one rule — survive. You did more than that.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O torneio tinha uma regra — sobreviver. Você fez mais que isso."
          }
        }
      }
    },
    "The tournament is not currently active.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O torneio não está ativo atualmente."
          }
        }
      }
    },
    "The trees here cry. No one knows why. You will find out.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As árvores aqui choram. Ninguém sabe por quê. Você vai descobrir."
          }
        }
      }
    },
    "The trial was designed to break you. You passed anyway.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O julgamento foi feito para te quebrar. Você passou assim mesmo."
          }
        }
      }
    },
    "The trigger and firing pin assembly.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O conjunto de gatilho e percussor."
          }
        }
      }
    },
    "The tunnels stretch before you. Pick and swing.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os túneis se estendem diante de você. Pique e golpeie."
          }
        }
      }
    },
    "The vendor has heard of your streak and sends a Void Elixir.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O vendedor ouviu falar da sua sequência e manda um Elixir do Vazio."
          }
        }
      }
    },
    "The vendor sends a Hellfire Elixir, distilled from infernal flame.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O vendedor manda um Elixir do Fogo Infernal, destilado de chama infernal."
          }
        }
      }
    },
    "The vendor sends a Hollow Elixir. Left behind by someone who no longer needs it.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O vendedor manda um Elixir do Vazio Oco. Deixado por alguém que não precisa mais dele."
          }
        }
      }
    },
    "The vendor sends a Shadow Elixir, brewed from the dark between worlds.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O vendedor manda um Elixir das Sombras, preparado a partir da escuridão entre os mundos."
          }
        }
      }
    },
    "The venom is not fast. It just waits inside you.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O veneno não é rápido. Apenas espera dentro de você."
          }
        }
      }
    },
    "The vines in this forest move. You noticed too late.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As trepadeiras desta floresta se movem. Você percebeu tarde demais."
          }
        }
      }
    },
    "The voice belonged to a Siren. Combat begins.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A voz pertencia a uma Sereia. O combate começa."
          }
        }
      }
    },
    "The voice was a trap. An Echo ambushes you. It adds corruption on hit.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A voz era uma armadilha. Um Eco te embosca. Ele adiciona corrupção a cada golpe."
          }
        }
      }
    },
    "The voice was not yours. An Echo steps out of the dark.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A voz não era sua. Um Eco sai da escuridão."
          }
        }
      }
    },
    "The voices grow louder. They speak of things that should not be.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As vozes ficam mais altas. Falam de coisas que não deveriam existir."
          }
        }
      }
    },
    "The void and the cold found each other in the deep abyss. They are inseparable now.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O vazio e o frio se encontraram no fundo do abismo. Agora são inseparáveis."
          }
        }
      }
    },
    "The void has very high standards. This one met them.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O vazio tem padrões muito altos. Este os atendeu."
          }
        }
      }
    },
    "The void is not nothing. The void is something that has chosen not to be something. Until now. Now it has chosen differently.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O vazio não é nada. O vazio é algo que escolheu não ser algo. Até agora. Agora escolheu diferente."
          }
        }
      }
    },
    "The void pulls at your soul.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O vazio puxa sua alma."
          }
        }
      }
    },
    "The void stopped being abstract.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O vazio parou de ser abstrato."
          }
        }
      }
    },
    "The walls glitter with forgotten wealth. No enemies — just riches waiting to be claimed.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As paredes brilham com riqueza esquecida. Nenhum inimigo — apenas tesouros esperando para serem reivindicados."
          }
        }
      }
    },
    "The walls pulse with heat. Your blood is up.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As paredes pulsam com calor. Seu sangue está agitado."
          }
        }
      }
    },
    "The walls weep blood. Something ancient awakens deep below.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As paredes choram sangue. Algo ancestral desperta nas profundezas."
          }
        }
      }
    },
    "The war ended. The fighting did not.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A guerra acabou. A luta não."
          }
        }
      }
    },
    "The warlord who refused death and was given something worse. He has sat in this crypt for a thousand years, perfectly still, perfectly aware, waiting for someone worth killing.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O senhor da guerra que recusou a morte e recebeu algo pior. Está sentado nesta cripta há mil anos, perfeitamente imóvel, perfeitamente consciente, esperando por alguém que valha a pena matar."
          }
        }
      }
    },
    "The wastes are quiet today. The fire has burned itself out.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ermos estão quietos hoje. O fogo se consumiu por completo."
          }
        }
      }
    },
    "The water glows with ancient light. Gold shimmers everywhere.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A água brilha com luz ancestral. Ouro reluz em todo lugar."
          }
        }
      }
    },
    "The water has receded. The archives breathe.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A água recuou. Os arquivos respiram."
          }
        }
      }
    },
    "The webs are old. The spider is older. It has been waiting specifically for you.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As teias são antigas. A aranha é mais antiga ainda. Esteve esperando especificamente por você."
          }
        }
      }
    },
    "The whispering started, as best anyone can document, about three hundred years ago. Or rather — that is when people began writing it down. The villagers suggest it has always been there too, that it is simply a thing you learn not to mention after a certain age, the way you learn not to mention other things. The whispers are not voices exactly. They are the shape of voices. The suggestion of words in a language that exists just outside the range of comprehension. Travelers who spend more than one night at the forest's edge report that the whispers begin to sound familiar. That they begin to sound like people they know. That they begin to sound like themselves.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os sussurros começaram, pelo que se pode documentar, há cerca de trezentos anos. Ou melhor — foi quando as pessoas começaram a escrever sobre isso. Os moradores sugerem que sempre estiveram lá também, que é simplesmente algo que se aprende a não mencionar depois de certa idade, da mesma forma que se aprende a não mencionar outras coisas. Os sussurros não são bem vozes. São a forma de vozes. A sugestão de palavras em uma língua que existe bem fora do alcance da compreensão. Viajantes que passam mais de uma noite na borda da floresta relatam que os sussurros começam a soar familiares. Que começam a soar como pessoas que conhecem. Que começam a soar como eles mesmos."
          }
        }
      }
    },
    "The whole ceiling is a web. You walked into it before you saw it.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O teto inteiro é uma teia. Você entrou nela antes de vê-la."
          }
        }
      }
    },
    "The witch thought she summoned this. She did not. It was already in the forest. It has been waiting much longer than three years.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A bruxa achou que havia invocado isto. Não invocou. Já estava na floresta. Esperava há muito mais que três anos."
          }
        }
      }
    },
    "The wrapping from The Offering. The shadow now guarantees its gifts are real. Offering events always give loot or gold.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A embalagem da Oferenda. A sombra agora garante que seus presentes são reais. Eventos de oferenda sempre dão itens ou ouro."
          }
        }
      }
    },
    "Their armor froze to their body centuries ago. They stopped noticing.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua armadura congelou junto ao corpo séculos atrás. Ele parou de notar."
          }
        }
      }
    },
    "Their armor is not red. It started a different color. They have been in the Spire a very long time.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua armadura não é vermelha. Começou com outra cor. Está na Torre há muito tempo."
          }
        }
      }
    },
    "Their shells are harder than iron ore. Miners used to collect them as curiosities. Then the mines went deep enough to find the big ones.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas cascas são mais duras que minério de ferro. Mineiros costumavam coletá-las como curiosidades. Depois as minas foram profundas o suficiente para encontrar as grandes."
          }
        }
      }
    },
    "Theme Music": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Música Tema"
          }
        }
      }
    },
    "Then:": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois:"
          }
        }
      }
    },
    "There are no floors here. No exits. Only waves. They will not stop. Neither will you — until you fall.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há andares aqui. Sem saídas. Apenas ondas. Elas não vão parar. Você também não — até você cair."
          }
        }
      }
    },
    "There is a fourth place. It does not have a location. It is not beneath the earth or buried under ash or frozen in ice. It is the space between all three — the dark that exists between the dark things. Explorers who have descended far enough into any of the three dungeons sometimes report a moment where the dungeon changes. The walls breathe. The enemies are wrong. The silence sounds different. Most believe this is exhaustion or fear. A small number believe they have crossed into something the dungeons share — a deeper layer where the three places touch. If they are right, what lives there has never been named. The dungeon refuses to name it. So do the people who came back.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Existe um quarto lugar. Ele não tem localização. Não está sob a terra, nem enterrado nas cinzas, nem congelado no gelo. É o espaço entre os três — a escuridão que existe entre as coisas escuras. Exploradores que desceram fundo o suficiente em qualquer uma das três masmorras às vezes relatam um momento em que a masmorra muda. As paredes respiram. Os inimigos estão errados. O silêncio soa diferente. A maioria acredita que isso é exaustão ou medo. Um pequeno número acredita ter cruzado para algo que as masmorras compartilham — uma camada mais profunda onde os três lugares se tocam. Se estiverem certos, o que vive lá nunca foi nomeado. A masmorra se recusa a nomeá-lo. Assim como as pessoas que voltaram."
          }
        }
      }
    },
    "There is a theology, practiced by a small number of scholars who do not advertise their beliefs, that holds that the underworld is not a place the dead go. It is a place that already exists, below the living world, and that the living world sits on top of it the way a house sits on a foundation. The foundation was there first. The house is temporary. The foundation is not.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Existe uma teologia, praticada por um pequeno número de eruditos que não anunciam suas crenças, que sustenta que o submundo não é um lugar para onde os mortos vão. É um lugar que já existe, abaixo do mundo dos vivos, e que o mundo dos vivos fica sobre ele da mesma forma que uma casa fica sobre uma fundação. A fundação estava lá primeiro. A casa é temporária. A fundação não é."
          }
        }
      }
    },
    "There is something beneath the Frosthold Abyss that is not ice, not stone, not cold. It has been pressing upward since before humans discovered fire. It is very close to the surface now.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há algo sob o Abismo Glacial que não é gelo, nem pedra, nem frio. Vem pressionando para cima desde antes de os humanos descobrirem o fogo. Está muito perto da superfície agora."
          }
        }
      }
    },
    "These combat keys work in The Spire and Daily Raid in addition to normal dungeons.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essas teclas de combate funcionam na Torre e na Missão Diária além das masmorras normais."
          }
        }
      }
    },
    "These commands only work on desktop with a keyboard. On mobile everything works by touch — these shortcuts do not apply. JAWS or NVDA will announce when a command is used.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes comandos só funcionam em desktop com teclado. No celular tudo funciona por toque — esses atalhos não se aplicam. JAWS ou NVDA vão anunciar quando um comando é usado."
          }
        }
      }
    },
    "These features are experimental and still being tested. Turn them on to try them out. They may change or be removed in future updates.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esses recursos são experimentais e ainda estão sendo testados. Ative-os para experimentar. Eles podem mudar ou ser removidos em futuras atualizações."
          }
        }
      }
    },
    "These rats followed ships down. They adapted. They attack in bursts of two strikes.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esses ratos seguiram os navios para o fundo. Se adaptaram. Atacam em rajadas de dois golpes."
          }
        }
      }
    },
    "They have lived in the abyss long enough that warmth is foreign to them. They bite because warmth angers them. They cannot explain why.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vivem no abismo há tempo suficiente para que o calor lhes seja estranho. Mordem porque o calor os enfurece. Não sabem explicar por quê."
          }
        }
      }
    },
    "They knew what the forest was. They went anyway. Now you know why that was a mistake.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabia o que era a floresta. Foi mesmo assim. Agora você sabe por que isso foi um erro."
          }
        }
      }
    },
    "They know what they did. They remember everything.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabem o que fizeram. Lembram-se de tudo."
          }
        }
      }
    },
    "They nest in the deepest shafts and come out only to hunt. The miners who disappeared in the lower tunnels — the bats know what happened to them.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fazem ninho nos poços mais profundos e só saem para caçar. Os mineiros que desapareceram nos túneis inferiores — os morcegos sabem o que aconteceu com eles."
          }
        }
      }
    },
    "They said one would come who could end the Void. This is that one.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Disseram que viria alguém capaz de acabar com o Vazio. Este é esse alguém."
          }
        }
      }
    },
    "They wandered in looking for the way out. They are still looking.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrou vagando em busca da saída. Ainda está procurando."
          }
        }
      }
    },
    "They went to explore the forest. They did not come back. This is what came back instead.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi explorar a floresta. Não voltou. Isto voltou em seu lugar."
          }
        }
      }
    },
    "They were sent to clear the Spire decades ago. They never came back. They are still clearing it.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foram enviados para limpar a Torre décadas atrás. Nunca voltaram. Ainda estão limpando."
          }
        }
      }
    },
    "Thick with centuries of ocean growth.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espesso com séculos de crescimento oceânico."
          }
        }
      }
    },
    "Thief": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladrão"
          }
        }
      }
    },
    "Thief Ring": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anel do Ladrão"
          }
        }
      }
    },
    "Thief, higher chance to find hidden loot": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladrão, maior chance de encontrar saque escondido"
          }
        }
      }
    },
    "Thirteen days. Unlucky for the dungeon, not for you.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Treze dias. Azar para a masmorra, não para você."
          }
        }
      }
    },
    "Thirty daily quests. You are more committed to this dungeon than anyone.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trinta missões diárias. Você é mais dedicado a esta masmorra do que qualquer um."
          }
        }
      }
    },
    "Thirty percent chance to phase through any attack.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trinta por cento de chance de atravessar qualquer ataque."
          }
        }
      }
    },
    "Thirty percent chance to phase through any attack. It does not choose when this happens. The void chooses for it. The void is generous.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trinta por cento de chance de atravessar qualquer ataque. Não é ele quem escolhe quando isso acontece. O vazio escolhe por ele. O vazio é generoso."
          }
        }
      }
    },
    "This account system is in Alpha. An account is": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este sistema de conta está em Alfa. Uma conta é"
          }
        }
      }
    },
    "This cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso não pode ser desfeito."
          }
        }
      }
    },
    "This cannot be undone. The dungeon will not remember your name.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso não pode ser desfeito. A masmorra não vai lembrar seu nome."
          }
        }
      }
    },
    "This code only works on September 7th. Brazil Independence Day.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código só funciona em 7 de setembro. Dia da Independência do Brasil."
          }
        }
      }
    },
    "This enemy fights differently.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este inimigo luta de forma diferente."
          }
        }
      }
    },
    "This game has been reviewed and certified compliant by the Department of Dungeon Descent Incorporated. All mandatory bug sweeps have been conducted on schedule. No violations were found. The Department is cautiously satisfied.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este jogo foi revisado e certificado como conforme pelo Departamento de Dungeon Descent Incorporated. Todas as varreduras obrigatórias de bugs foram conduzidas no cronograma. Nenhuma violação foi encontrada. O Departamento está cautelosamente satisfeito."
          }
        }
      }
    },
    "This game was built with full screen reader support. If you use JAWS, NVDA, VoiceOver or any other screen reader we can enable all accessibility features automatically.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este jogo foi construído com suporte completo a leitores de tela. Se você usa JAWS, NVDA, VoiceOver ou qualquer outro leitor de tela, podemos ativar todos os recursos de acessibilidade automaticamente."
          }
        }
      }
    },
    "This is how you will appear on the global leaderboard. Letters, numbers and underscores only.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É assim que você vai aparecer no ranking global. Apenas letras, números e sublinhados."
          }
        }
      }
    },
    "This place exists between the dungeon floors — a rift where shadow entities drift endlessly, waiting for something strong enough to fight.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este lugar existe entre os andares da masmorra — uma fenda onde entidades sombrias flutuam infinitamente, esperando por algo forte o suficiente para lutar."
          }
        }
      }
    },
    "This quick guide will show you how everything works. You can skip it anytime.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este guia rápido vai te mostrar como tudo funciona. Você pode pulá-lo a qualquer momento."
          }
        }
      }
    },
    "This recipe requires the Alchemist class.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta receita requer a classe Alquimista."
          }
        }
      }
    },
    "This will permanently delete": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso vai excluir permanentemente"
          }
        }
      }
    },
    "Thorn Blade": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lâmina de Espinhos"
          }
        }
      }
    },
    "Thorned vine — 1.4x damage and reduces enemy attack.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Videira espinhosa — 1,4x de dano e reduz o ataque do inimigo."
          }
        }
      }
    },
    "Thornmail": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cota de Espinhos"
          }
        }
      }
    },
    "Thornvine Crawler": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rastejador de Espinhos"
          }
        }
      }
    },
    "Three bosses. Three battles. Three victories. They will not be forgotten.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Três chefes. Três batalhas. Três vitórias. Não serão esquecidas."
          }
        }
      }
    },
    "Three days. The dungeon is starting to respect you.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Três dias. A masmorra está começando a te respeitar."
          }
        }
      }
    },
    "Three elixirs combined into one Golden Elixir. It fully restores HP and boosts attack when used.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Três elixires foram combinados em um Elixir Dourado. Ele restaura totalmente o HP e aumenta o ataque quando usado."
          }
        }
      }
    },
    "Three hundred floors. Most adventurers stop long before this.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trezentos andares. A maioria dos aventureiros para muito antes disso."
          }
        }
      }
    },
    "Three hundred gold in hand. The weight of it feels good.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trezentos de ouro na mão. O peso disso é bom."
          }
        }
      }
    },
    "Three hundred years of submersion have not improved their disposition.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trezentos anos submersos não melhoraram seu temperamento."
          }
        }
      }
    },
    "Three new achievements — Origin Seeker, The Real Story, Found Him.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Três novas conquistas — Buscador da Origem, A História Real, Encontrei Ele."
          }
        }
      }
    },
    "Three nightmares faced. None survived.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Três pesadelos enfrentados. Nenhum sobreviveu."
          }
        }
      }
    },
    "Three phase boss fight. Gavel the size of a door. 47-page compliance document. 280 HP.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Luta de chefe de três fases. Martelo do tamanho de uma porta. Documento de conformidade de 47 páginas. 280 HP."
          }
        }
      }
    },
    "Three times over. The dungeon gave up trying to stop you.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Três vezes seguidas. A masmorra desistiu de tentar te parar."
          }
        }
      }
    },
    "Three tournament bosses rotate each season — The Eternal Colossus, The Void Sovereign, The Ancient King.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Três chefes de torneio se alternam a cada temporada — O Colosso Eterno, O Soberano do Vazio, O Rei Ancestral."
          }
        }
      }
    },
    "Three weeks. The dungeon has run out of ways to test you.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Três semanas. A masmorra ficou sem formas de testar você."
          }
        }
      }
    },
    "Throw acid — deals 1.4x damage and reduces enemy defense.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance ácido — causa 1,4x de dano e reduz a defesa do inimigo."
          }
        }
      }
    },
    "Throw at enemy — deals 40% of their max HP as fire damage. Ignores defense.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arremesse no inimigo — causa 40% do HP máximo dele em dano de fogo. Ignora defesa."
          }
        }
      }
    },
    "Throw smoke — enemy has 35% miss chance next turn.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance fumaça — inimigo tem 35% de chance de errar no próximo turno."
          }
        }
      }
    },
    "Throw your weapon for a ranged strike dealing 1.2x damage.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance sua arma para um golpe à distância causando 1,2x de dano."
          }
        }
      }
    },
    "Thunder Moth shocks the enemy — stunned!": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Traça do Trovão choca o inimigo — atordoado!"
          }
        }
      }
    },
    "Thunderfist": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Punho do Trovão"
          }
        }
      }
    },
    "Tidal Elixir": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Elixir das Marés"
          }
        }
      }
    },
    "Tidal wave of nature — 2.5x damage plus 20 HP heal.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onda de maré da natureza — 2,5x de dano mais cura de 20 HP."
          }
        }
      }
    },
    "Tide Golem": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Golem da Maré"
          }
        }
      }
    },
    "Tide Wraith": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espectro da Maré"
          }
        }
      }
    },
    "Tiefling, infernal, bonus luck and intelligence": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiefling, infernal, bônus de sorte e inteligência"
          }
        }
      }
    },
    "Time Devourer": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Devorador de Tempo"
          }
        }
      }
    },
    "Time Fracture! Next enemy attack will be dodged.": {
      "extractionState": "manual",
