    "Version 10.8 — The Arsenal Update. Guns, The Mine, new enemies, major bug fixes, and more. Press Descend to continue.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Versão 10.8 — A Atualização do Arsenal. Armas de fogo, A Mina, novos inimigos, correções importantes de bugs e mais. Pressione Descer para continuar."
          }
        }
