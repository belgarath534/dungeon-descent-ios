        }
      }
    },
    "Notified on the 1st of each month — higher risk, higher reward.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificado no dia 1 de cada mês — mais risco, mais recompensa."
