      }
    },
    "Market Sprite costs 50 gold to reactivate each new run — unique mechanic": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Espírito do Mercado custa 50 de ouro para reativar em cada nova partida — mecânica única"
          }
        }
      }
    },
    "Market Sprite — new starter spirit giving 20% shop discount all run": {
