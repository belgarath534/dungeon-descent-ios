    "The Easter Bunny": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Coelho da Páscoa"
          }
        }
      }
    },
    "The Easter Bunny adjusts its bow tie. It does not look afraid. It should look afraid.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Coelho da Páscoa ajusta sua gravata-borboleta. Ele não parece assustado. Deveria parecer."
          }
        }
      }
    },
    "The Easter Bunny. A large rabbit in a bow tie is in the room. Three options: fight it for XP, adopt it as your spirit companion, or let it go in peace.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Coelho da Páscoa. Um coelho grande de gravata-borboleta está na sala. Três opções: lutar por XP, adotá-lo como espírito companheiro, ou deixá-lo ir em paz."
          }
        }
      }
    },
    "The Easter Update": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Atualização da Páscoa"
