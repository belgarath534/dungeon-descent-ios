    "⌛ Time Potion! Time slows. You get 2 free attacks. Enemy cannot respond.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⌛ Poção do Tempo! O tempo desacelera. Você recebe 2 ataques gratuitos. O inimigo não pode responder."
          }
        }
      }
    },
    "⌛ Time Stop failed. Time rejected you. Instant defeat.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⌛ Parada do Tempo falhou. O tempo te rejeitou. Derrota instantânea."
          }
        }
      }
    },
    "⌛ Time Stop! 3 free attacks — enemy cannot respond!": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⌛ Parada do Tempo! 3 ataques gratuitos — o inimigo não pode responder!"
          }
        }
      }
    },
    "⌨ Key Commands": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⌨ Comandos de Teclado"
          }
        }
      }
    },
    "⌨ Keyboard commands fully working — Ctrl+Shift navigation, Alt+key combat, Page Up/Down volume, Backspace pause menu.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⌨ Comandos de teclado totalmente funcionais — navegação Ctrl+Shift, combate Alt+tecla, volume Page Up/Down, menu de pausa com Backspace."
          }
        }
      }
    },
    "⌨ Keyboard commands system — full PC keyboard navigation. Alt+H for menu, A to attack, D to defend and more. New Key Commands tab in Help.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⌨ Sistema de comandos de teclado — navegação completa por teclado no PC. Alt+H para menu, A para atacar, D para defender e mais. Nova aba de Comandos de Teclado em Ajuda."
          }
        }
      }
    },
    "⌨ PC Only — Keyboard Commands": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
