    "Lock the enemy in time — frozen for 2 turns, take 1.5x damage.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenda o inimigo no tempo — congelado por 2 turnos, recebe 1,5x de dano."
          }
        }
      }
    },
    "Locked entry. ": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrada bloqueada. "
          }
        }
      }
    },
    "Locks everything except the Crypt.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueia tudo exceto a Cripta."
          }
        }
      }
    },
    "Long enough to fill a shaft. Old enough to remember when the mine was a mountain. Hungry in the way that only very patient things can be hungry.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Longo o suficiente para preencher um poço. Velho o suficiente para lembrar quando a mina era uma montanha. Faminto do jeito que só coisas muito pacientes podem estar."
          }
        }
      }
    },
    "Looks exactly like you. Has your stats. Is not you. Knows it is not you. Does not care.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece exatamente com você. Tem seus atributos. Não é você. Sabe que não é você. Não se importa."
          }
        }
      }
    },
    "Looks like a chest until engaged. Surprise attack first turn deals double damage.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece um baú até ser confrontado. Ataque surpresa no primeiro turno causa dano dobrado."
          }
        }
      }
    },
    "Loop all songs": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Repetir todas as músicas"
