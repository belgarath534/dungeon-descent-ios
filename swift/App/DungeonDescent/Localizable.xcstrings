    },
    "Raises fallen enemies as undead servants. Sacrifices HP for power. Benefits from death itself.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ressuscita inimigos caídos como servos mortos-vivos. Sacrifica HP por poder. Se beneficia da própria morte."
          }
        }
      }
    },
    "Rally anthem — restore 15 HP and 10 SP.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hino de convocação — restaure 15 HP e 10 SP."
          }
        }
      }
    },
    "Ran the archives before the flooding. Now runs the underwater version. Standards have slipped.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Administrava os arquivos antes da inundação. Agora administra a versão submersa. Os padrões caíram."
          }
        }
      }
    },
    "Ran the house for forty years. Still does. Her definition of the house has expanded considerably.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Administrou a casa por quarenta anos. Ainda administra. Sua definição de casa se expandiu consideravelmente."
          }
        }
      }
    },
    "Random modifiers each run like Burning Dungeon and Death March.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificadores aleatórios em cada partida, como Masmorra em Chamas e Marcha da Morte."
          }
        }
      }
    },
    "Random skill unlock system — choose 1 of 3 options every level up": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema de desbloqueio de habilidade aleatório — escolha 1 de 3 opções a cada subida de nível"
          }
        }
      }
    },
    "Ranger": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arqueiro"
          }
        }
