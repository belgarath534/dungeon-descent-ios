    },
    "Wave 1 — A lone Warrior. Weak. Overconfident.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onda 1 — Um Guerreiro solitário. Fraco. Excesso de confiança."
          }
        }
      }
    },
    "Wave 1 — Enemies": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onda 1 — Inimigos"
          }
        }
      }
    },
    "Wave 2 — A Paladin and an Archer. They think numbers will save them.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onda 2 — Um Paladino e um Arqueiro. Eles acham que o número vai salvá-los."
          }
        }
      }
    },
    "Wave 3 — Two Warriors and a Mage. Getting serious.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onda 3 — Dois Guerreiros e um Mago. Ficando sério."
          }
        }
      }
    },
    "Wave 4 — Three heroes including an Elite. They have a plan.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onda 4 — Três heróis incluindo um Elite. Eles têm um plano."
          }
        }
      }
    },
    "Wave 5 — A full party of 4. One of them is legendary.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onda 5 — Um grupo completo de 4. Um deles é lendário."
          }
        }
      }
    },
    "Wave Points": {
