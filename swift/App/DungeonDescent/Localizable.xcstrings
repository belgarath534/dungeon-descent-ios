        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualização da versão 11.2"
          }
        }
      }
    },
    "Version 11.2 — The Shadow World Improvement Update. Shapeshifter Mask with 12 abilities. 4 new Shadow loot items. Stalker Floor spatial audio. Music Player improvements. ElevenLabs narration in the Library. Press Enter the Shadow to continue.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Versão 11.2 — A Atualização de Melhorias do Mundo das Sombras. Máscara do Metamorfo com 12 habilidades. 4 novos itens de saque das Sombras. Áudio espacial do Andar do Perseguidor. Melhorias no Player de Música. Narração ElevenLabs na Biblioteca. Pressione Entrar na Sombra para continuar."
          }
        }
      }
    },
