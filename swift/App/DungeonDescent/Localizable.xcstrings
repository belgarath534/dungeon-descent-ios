    "Win the tournament boss → earn 5 Mystery Coins.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vença o chefe do torneio → ganhe 5 Moedas Misteriosas."
