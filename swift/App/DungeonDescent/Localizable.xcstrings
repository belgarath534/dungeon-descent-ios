    "Lord Phorcys": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorde Phorcys"
          }
        }
      }
    },
    "Lord Phorcys appears. Medusa's father. He has been searching for her. They find each other.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lord Phorcys aparece. O pai de Medusa. Ele tem procurado por ela. Eles se encontram."
          }
        }
      }
    },
    "Lord Phorcys — her father. 60% chance per room to appear after she joins you (decays 3% per reunion, floors at 36%, resets every 30 days). Reunion gives +50 gold and the Found achievement.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lord Phorcys — seu pai. 60% de chance por sala de aparecer depois que ela se junta a você (decai 3% por reunião, mínimo de 36%, reinicia a cada 30 dias). A reunião dá +50 de ouro e a conquista Encontrado."
          }
        }
      }
    },
    "Lord Phorcys. He has been searching for his daughter. He blames everyone he meets. He attacks. He is strong — but broken.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lord Phorcys. Ele tem procurado por sua filha. Ele culpa todos que encontra. Ele ataca. Ele é forte — mas quebrado."
          }
        }
      }
    },
    "Lord Phorcys. Her father. He has been searching the Hollow for years.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lord Phorcys. O pai dela. Ele tem procurado na Cova por anos."
          }
        }
      }
    },
