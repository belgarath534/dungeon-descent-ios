      }
    },
    "Tear the soul — 2x damage, reduces enemy max HP by 10.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rasgue a alma — 2x de dano, reduz o HP máximo do inimigo em 10."
          }
        }
      }
    },
    "Tears through reality itself.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rasga a própria realidade."
          }
        }
      }
    },
    "Tears through the void itself.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rasga o próprio vazio."
          }
        }
      }
    },
    "Tell your epic — every kill this run permanently boosts your ATK.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conte sua saga — cada abate nesta partida aumenta permanentemente seu ATQ."
          }
        }
      }
    },
    "Temporal Mage": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mago Temporal"
          }
        }
      }
    },
    "Ten classes mastered. There is no version of this dungeon you cannot handle.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dez classes dominadas. Não há versão desta masmorra que você não possa enfrentar."
          }
        }
      }
    },
    "Ten complete runs. The dungeon has started expecting you.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dez partidas completas. A masmorra começou a esperar por você."
          }
        }
      }
    },
    "Ten days. A milestone most never reach.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dez dias. Um marco que a maioria nunca alcança."
          }
        }
      }
    },
    "Ten deaths and still here. What you lack in survival you make up for in stubbornness.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dez mortes e ainda aqui. O que falta em sobrevivência, você compensa em obstinação."
          }
        }
      }
    },
    "Ten elixirs consumed. You have learned the old recipes.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dez elixires consumidos. Você aprendeu as receitas antigas."
          }
        }
      }
    },
    "Ten minutes. The dungeon barely had time to react before you were gone.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dez minutos. A masmorra quase não teve tempo de reagir antes de você desaparecer."
          }
        }
      }
    },
