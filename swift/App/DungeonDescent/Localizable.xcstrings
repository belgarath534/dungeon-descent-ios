            "value": "Vale 18 de ouro."
          }
        }
      }
    },
    "Worth 18 gold. Glows faintly green.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale 18 de ouro. Brilha fracamente em verde."
          }
        }
      }
    },
    "Worth 20 gold.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale 20 de ouro."
