    "Spell Book acquired. Magic classes can now learn spells permanently.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Livro de Feitiços adquirido. Classes mágicas agora podem aprender feitiços permanentemente."
          }
