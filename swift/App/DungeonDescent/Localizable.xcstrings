    },
    "The Sanity Drainer. A special Insane Mode enemy. Defeat it to earn an Insanity Potion. It drains your sanity with every hit.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Drenador de Sanidade. Um inimigo especial do Modo Insano. Derrote-o para ganhar uma Poção da Insanidade. Ele drena sua sanidade a cada golpe."
          }
        }
      }
    },
