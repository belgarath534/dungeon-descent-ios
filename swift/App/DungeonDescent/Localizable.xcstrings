    "🏹 Hunter Mode Survival": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "🏹 Sobrevivência do Modo Caçador"
          }
        }
      }
    },
    "🏹 Hunter Mode — a relentless hunter now stalks you through the dungeon. Enable it at character creation (Step 9) or toggle it anytime from the pause menu. Every move you make, it moves too. Every turn you waste, it gets closer.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "🏹 Modo Caçador — um caçador implacável agora te persegue pela masmorra. Ative no Passo 9 da criação do personagem ou alterne a qualquer momento no menu de pausa. Cada movimento que você faz, ele também faz. Cada turno que você perde, ele se aproxima."
          }
        }
      }
    },
    "🏹 Hunter Mode:": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
