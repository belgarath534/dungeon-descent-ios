    "Weak alone. Always spawns with a second Shadow Pup.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fraco sozinho. Sempre surge com um segundo Filhote das Sombras."
          }
        }
      }
    },
    "Weak per shot but 10 shots before reloading. Sustained pressure. Never lets the enemy breathe.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fraca por tiro, mas 10 tiros antes de recarregar. Pressão sustentada. Nunca deixa o inimigo respirar."
          }
        }
      }
    },
    "Weapon Forge": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Forja de Armas"
          }
        }
      }
    },
    "Weapon is already in perfect condition.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A arma já está em condição perfeita."
          }
        }
      }
    },
    "Weapon unequipped and returned to inventory.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arma desequipada e devolvida ao inventário."
          }
        }
      }
    },
    "Weapons you buy go straight into your inventory. Open your inventory to equip them.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Armas que você compra vão direto para o seu inventário. Abra seu inventário para equipá-las."
          }
        }
      }
    },
    "Weather and New Professions": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clima e Novas Profissões"
          }
        }
      }
    },
    "Weather shown in dungeon topbar and announced by JAWS when you enter.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clima mostrado na barra superior da masmorra e anunciado pelo JAWS quando você entra."
          }
        }
      }
    },
    "Weave two spells — deal 1.3x damage twice.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Teça dois feitiços — cause 1,3x de dano duas vezes."
          }
        }
      }
    },
    "Weaves a corruption web — passive 8 damage per turn until destroyed with a Heavy Strike.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tece uma teia de corrupção — 8 de dano passivo por turno até ser destruída com um Golpe Pesado."
          }
        }
      }
    },
    "Web Stalker": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perseguidora das Teias"
          }
        }
      }
    },
    "Weekly Champion! You are number 1 on the global leaderboard this week. 3 Mystery Coins have been added to your account.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Campeão Semanal! Você é o número 1 no ranking global esta semana. 3 Moedas Misteriosas foram adicionadas à sua conta."
          }
        }
      }
    },
    "Weekly streak progress": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Progresso da sequência semanal"
          }
        }
      }
    },
    "Weeping Child always auto-soothed. Holy skills 20% stronger.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Criança Chorosa sempre acalmada automaticamente. Habilidades sagradas 20% mais fortes."
          }
        }
      }
    },
    "Weeping Child in raid mode skips soothe and goes straight to combat — no exploits": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Criança Chorosa no modo missão pula o acalmar e vai direto para o combate — sem exploits"
          }
        }
      }
    },
    "Weeping Child now has 3 options when you have the Music Box item: Pick Up (50%), Hum (55%), or Play Music Box (75%, consumes item).": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Criança Chorosa agora tem 3 opções quando você tem o item Caixa de Música: Pegar (50%), Cantarolar (55%), ou Tocar a Caixa de Música (75%, consome o item)."
          }
        }
      }
    },
    "Welcome": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bem-vindo"
          }
        }
      }
    },
    "Welcome to Dungeon Descent": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bem-vindo a Dungeon Descent"
          }
        }
      }
    },
    "Welcome to Dungeon Descent. Are you using a screen reader? Press the first button to enable all accessibility features, or the second button to continue without them.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bem-vindo ao Dungeon Descent. Você está usando um leitor de tela? Pressione o primeiro botão para ativar todos os recursos de acessibilidade, ou o segundo botão para continuar sem eles."
          }
        }
      }
    },
    "Welcome to Dungeon Descent. You can enable accessibility features at any time in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bem-vindo ao Dungeon Descent. Você pode ativar recursos de acessibilidade a qualquer momento nas Configurações."
          }
        }
      }
    },
    "Welcome to version 10.3.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bem-vindo à versão 10.3."
          }
        }
      }
    },
    "Welcome to version 10.5. The dungeon awaits.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bem-vindo à versão 10.5. A masmorra espera."
          }
        }
      }
    },
    "Welcome to version 10.7. The Storage Upgrade. The dungeon awaits.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bem-vindo à versão 10.7. A Melhoria de Armazenamento. A masmorra espera."
          }
        }
      }
    },
    "Welcome to version 10.8. The Arsenal Update. The dungeon awaits.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bem-vindo à versão 10.8. A Atualização do Arsenal. A masmorra espera."
          }
        }
      }
    },
    "Welcome to version 10.9. The Codex Update. The dungeon awaits.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bem-vindo à versão 10.9. A Atualização do Códex. A masmorra espera."
          }
        }
      }
    },
    "Welcome to version 11.0. The Community Update. The dungeon awaits.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bem-vindo à versão 11.0. A Atualização da Comunidade. A masmorra espera."
          }
        }
      }
    },
    "Welcome to version 11.1. The Shadow World awaits.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bem-vindo à versão 11.1. O Mundo das Sombras espera."
          }
        }
      }
    },
    "Welcome to version 11.2. The Shadow World awaits.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bem-vindo à versão 11.2. O Mundo das Sombras espera."
          }
        }
      }
    },
    "Welcome to version 11.3. The Hollow stirs. Descend.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bem-vindo à versão 11.3. O Vazio se agita. Desça."
          }
        }
      }
    },
    "Welcome — Step 1 of 8": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bem-vindo — Passo 1 de 8"
          }
        }
      }
    },
    "What do the stats mean? Tap to learn.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que significam os atributos? Toque para saber."
          }
        }
      }
    },
    "What grief becomes when it has nowhere to go for long enough.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que o luto se torna quando não tem para onde ir por tempo suficiente."
          }
        }
      }
    },
    "What happens when I die?": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que acontece quando eu morro?"
          }
        }
      }
    },
    "What is Dungeon Descent?": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que é Dungeon Descent?"
          }
        }
      }
    },
    "What is New popup shows once per version on first load.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pop-up de Novidades aparece uma vez por versão no primeiro carregamento."
          }
        }
      }
    },
    "What is New screen. Patch notes for every version.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tela de Novidades. Notas de atualização de cada versão."
          }
        }
      }
    },
    "What is a run?": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que é uma partida?"
          }
        }
      }
    },
    "What is known is that families have lived there. Census records show occupants across several centuries, different names, different generations, all listing the same address. The records stop abruptly for each family. Not death records. Not moving records. Just a gap, and then new names, and then another gap. Nobody seems to have asked why.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que se sabe é que famílias viveram lá. Registros censitários mostram ocupantes ao longo de vários séculos, nomes diferentes, gerações diferentes, todos listando o mesmo endereço. Os registros terminam abruptamente para cada família. Não registros de morte. Não registros de mudança. Apenas um vazio, e depois novos nomes, e depois outro vazio. Ninguém parece ter perguntado por quê."
          }
        }
      }
    },
    "What is left when something violent happens and the energy does not dissipate. It has been accumulating for 3000 years.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que resta quando algo violento acontece e a energia não se dissipa. Está se acumulando há 3000 anos."
          }
        }
      }
    },
    "What remains after violent death. Gains +4 ATK every turn it survives. Burst it down fast.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que resta após uma morte violenta. Ganha +4 ATQ a cada turno que sobrevive. Derrube-o rápido."
          }
        }
      }
    },
    "What remains of a person after the fire has taken everything worth taking. The body still moves. There is nothing inside it that remembers why.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que resta de uma pessoa depois que o fogo levou tudo que valia a pena levar. O corpo ainda se move. Não há nada dentro dele que se lembre do motivo."
          }
        }
      }
    },
    "What remains of someone who burned completely. Not flesh, not bone — just the smoke of a person, still moving with the momentum of a life that ended.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que resta de alguém que queimou completamente. Não é carne, não é osso — apenas a fumaça de uma pessoa, ainda se movendo com o impulso de uma vida que terminou."
          }
        }
      }
    },
    "What the Spire leaves behind when it finishes with something. The soul is gone. The hunger is not.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que a Torre deixa para trás quando termina com algo. A alma se foi. A fome não."
          }
        }
      }
    },
    "What's New": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Que Há de Novo"
          }
        }
      }
    },
    "What's New screen — full patch notes for every version": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tela de Novidades — notas de atualização completas de cada versão"
          }
        }
      }
    },
    "What's New — Patch Notes": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Que Há de Novo — Notas de Atualização"
          }
        }
      }
    },
    "What's New, see the full patch notes for every version": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Que Há de Novo, veja as notas de atualização de cada versão"
          }
        }
      }
    },
    "Whatever rules the void between dungeons. It has a name but it will not say it.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que quer que governe o vazio entre as masmorras. Tem um nome, mas não vai dizê-lo."
          }
        }
      }
    },
    "Whatever was at the very bottom of this mine before the miners arrived. They sealed it away and never spoke of what they found. The seal has been broken for some time now.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que quer que estivesse no fundo desta mina antes dos mineiros chegarem. Eles o selaram e nunca falaram sobre o que encontraram. O selo está rompido há algum tempo agora."
          }
        }
      }
    },
    "Whatever was in this pumpkin is now out of the pumpkin and very upset about it.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que quer que estivesse dentro desta abóbora agora está fora dela e muito irritado com isso."
          }
        }
      }
    },
    "When Medusa is defeated — choose to raise or lower the shield. Lower it and she collapses. She was just a girl.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando Medusa é derrotada — escolha levantar ou abaixar o escudo. Abaixe-o e ela desmaia. Ela era só uma garota."
          }
        }
      }
    },
    "When Verbose Mode is on your screen reader announces extra detail about every action — full damage numbers, miss explanations, skill descriptions when used, item descriptions when found. When off announcements are shorter and faster. Recommended on for new players, can be turned off once you know the game well.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o Modo Detalhado está ativado seu leitor de tela anuncia detalhes extras sobre cada ação — números completos de dano, explicações de erro, descrições de habilidade quando usadas, descrições de item quando encontrados. Quando desativado os anúncios são mais curtos e rápidos. Recomendado ativado para novos jogadores, pode ser desativado quando você conhecer bem o jogo."
          }
        }
      }
    },
    "When an achievement unlocks a visual popup appears in the bottom right corner and your screen reader announces it automatically. You can turn the visual popup on or off in Settings under Accessibility — Achievement Notifications. Your screen reader will always announce achievements regardless of this setting.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando uma conquista desbloqueia, um pop-up visual aparece no canto inferior direito e seu leitor de tela anuncia automaticamente. Você pode ativar ou desativar o pop-up visual em Configurações em Acessibilidade — Notificações de Conquista. Seu leitor de tela sempre vai anunciar conquistas independente desta configuração."
          }
        }
      }
    },
    "When enabled in Settings, the game injects heading roles throughout every screen. H1 for screen titles and dungeon floor names. H2 for section titles, menu buttons, tabs, character names, and enemy names. H3 for individual bestiary entries, achievements, library stories, and skill names. With headings on you can press H in JAWS to jump instantly between sections instead of tabbing through everything.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado em Configurações, o jogo injeta funções de cabeçalho em cada tela. H1 para títulos de tela e nomes de andares de masmorra. H2 para títulos de seção, botões de menu, abas, nomes de personagens e nomes de inimigos. H3 para entradas individuais do bestiário, conquistas, histórias da biblioteca e nomes de habilidades. Com cabeçalhos ativados você pode pressionar H no JAWS para saltar instantaneamente entre seções em vez de tabular por tudo."
          }
        }
      }
    },
    "When it plays, you cannot help but listen. Forces you to defend for one turn.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando toca, você não consegue deixar de escutar. Te força a se defender por um turno."
          }
        }
      }
    },
    "When on disables ember particle effects, grain overlay animation, vignette animation, and torch flicker. Reduces visual noise for players who prefer a cleaner interface or have motion sensitivity. Has no effect on gameplay.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado desativa efeitos de partículas de brasa, animação de sobreposição de grão, animação de vinheta e tremular de antorchas. Reduz o ruído visual para jogadores que preferem uma interface mais limpa ou têm sensibilidade a movimento. Não tem efeito na jogabilidade."
          }
        }
      }
    },
    "When on your screen reader announces every combat event in detail — your damage, enemy damage, crits, misses, status effects, skill activations. When off only the most important events are announced. Combat Announcements is separate from Verbose Mode — you can have one on and the other off.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado seu leitor de tela anuncia cada evento de combate em detalhe — seu dano, dano do inimigo, críticos, erros, efeitos de status, ativações de habilidade. Quando desativado apenas os eventos mais importantes são anunciados. Anúncios de Combate é separado do Modo Detalhado — você pode ter um ativado e o outro desativado."
          }
        }
      }
    },
    "When the bell rings your turn is skipped. It always rings on the second turn.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o sino toca, seu turno é pulado. Ele sempre toca no segundo turno."
          }
        }
      }
    },
    "When you choose Attack, Heavy, or a skill the game asks you to choose your target first. A list of living enemies appears — select one to strike it. Defend and Potion do not require a target and apply immediately. Flee has a 40% success chance in ambushes.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você escolhe Atacar, Pesado ou uma habilidade, o jogo pede que você escolha seu alvo primeiro. Uma lista de inimigos vivos aparece — selecione um para golpeá-lo. Defender e Poção não requerem um alvo e se aplicam imediatamente. Fugir tem 40% de chance de sucesso em embuscadas."
          }
        }
      }
    },
    "When you create a new character you are asked to name your guide at Step 9 — a companion who walks with you through every dungeon. She speaks during boss fights, level ups, low HP moments, achievements, hunter encounters, and death. Her portrait appears at the bottom of the screen whenever she has something to say. Tap the X button to dismiss her message. She stays consistent throughout every run.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você cria um novo personagem, é solicitado que nomeie sua guia no Passo 9 — uma companheira que caminha com você por cada masmorra. Ela fala durante lutas de chefe, subidas de nível, momentos de HP baixo, conquistas, encontros com o caçador e morte. Seu retrato aparece na parte inferior da tela sempre que ela tem algo a dizer. Toque no botão X para dispensar sua mensagem. Ela permanece consistente durante toda a partida."
          }
        }
      }
    },
    "When you die the screen goes dark and a unique line plays before the defeat screen. The line is specific to your dungeon, the floor you reached, and the enemy that killed you. The Weeping Child, Music Box, and Oldest Guest in The Hollow each have their own unique death lines. Your screen reader reads the line fully before the run summary appears.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você morre a tela escurece e uma frase única toca antes da tela de derrota. A frase é específica para sua masmorra, o andar que você alcançou e o inimigo que te matou. A Criança Chorosa, a Caixa de Música e o Hóspede Mais Antigo no Vazio têm suas próprias frases de morte únicas. Seu leitor de tela lê a frase completamente antes do resumo da partida aparecer."
          }
        }
      }
    },
    "When you die you rewind 1 turn. Once per combat. The paradox saves you from death itself.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você morre, retrocede 1 turno. Uma vez por combate. O paradoxo te salva da própria morte."
          }
        }
      }
    },
    "When you unlock a new dungeon a one-time popup appears on the character select screen with the dungeon name, description, and details. It only ever appears once per dungeon. The popup plays the unlock sound and your screen reader reads the full announcement.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você desbloqueia uma nova masmorra, um pop-up único aparece na tela de seleção de personagem com o nome, descrição e detalhes da masmorra. Ele só aparece uma vez por masmorra. O pop-up toca o som de desbloqueio e seu leitor de tela lê o anúncio completo."
          }
        }
      }
    },
    "When you would die, survive at 1 HP once per dungeon. Death refuses you.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você fosse morrer, sobreviva com 1 HP uma vez por masmorra. A morte te rejeita."
          }
        }
      }
    },
    "Whenever the 13th falls on a Friday. The main menu goes dark. The dungeon plays Halloween music. A black box appears somewhere in the dungeon. If you open it, The Unlucky One steps out — a boss that steals your gold, disables all crits, and hits harder than anything you have faced.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre que o dia 13 cair numa sexta-feira. O menu principal fica escuro. A masmorra toca música de Halloween. Uma caixa preta aparece em algum lugar da masmorra. Se você a abrir, O Desafortunado sai — um chefe que rouba seu ouro, desativa todos os críticos, e bate mais forte do que qualquer coisa que você já enfrentou."
          }
        }
      }
    },
    "Where a person used to be, there is now nothing. The shape remains. The nothing inside it reaches for you.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde uma pessoa costumava estar, agora não há nada. A forma permanece. O nada dentro dela se estende até você."
          }
        }
      }
    },
    "Where did you come from? Grants a small bonus and writes your first journal entry. Skip to descend immediately.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De onde você veio? Concede um pequeno bônus e escreve sua primeira entrada de diário. Pule para descer imediatamente."
          }
        }
      }
    },
    "Where the Plague Hound carries the sickness in its body, the Plague Wraith IS the sickness. It spreads disease through the air around it without ever needing to touch you.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto o Cão da Peste carrega a doença em seu corpo, o Espectro da Peste É a doença. Espalha a enfermidade pelo ar ao seu redor sem nunca precisar tocar você."
          }
        }
      }
    },
    "Which dungeon this enemy lives in": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em qual masmorra este inimigo vive"
          }
        }
      }
    },
    "Who faces the shadow?": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem enfrenta a sombra?"
          }
        }
      }
    },
    "Wields holy power to smite evil and shield against darkness.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Empunha poder sagrado para destruir o mal e proteger contra a escuridão."
          }
        }
      }
    },
    "Wields raw arcane chaos. Glass cannon — obliterates first.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Empunha caos arcano bruto. Canhão de vidro — aniquila primeiro."
          }
        }
      }
    },
    "Wild Sage": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sábio Selvagem"
          }
        }
      }
    },
    "Wild regeneration — heal 10 HP per turn for 3 turns.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Regeneração selvagem — cure 10 HP por turno durante 3 turnos."
          }
        }
      }
    },
    "Wild swing dealing 1.6x damage but taking 5 HP.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Golpe selvagem causando 1,6x de dano, mas recebendo 5 HP de dano."
          }
        }
      }
    },
    "Win 5 raids.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vença 5 missões."
