    "Rare crystal. Use at the Blacksmith for 3 free weapon upgrades.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cristal raro. Use no Ferreiro para 3 melhorias de arma gratuitas."
          }
        }
      }
    },
    "Rare items found in forest.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Itens raros encontrados na floresta."
          }
        }
      }
    },
    "Rare lightning fragment. Crackles with energy.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragmento raro de raio. Crepita com energia."
          }
        }
      }
    },
    "Rare spirits require level 5 to activate": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espíritos raros requerem nível 5 para ativar"
          }
        }
      }
    },
    "Rare — All Dungeons": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Raro — Todas as Masmorras"
          }
        }
      }
    },
    "Rare. +50% ATK and Fury. Fail: enemy also gets +25% ATK and Fury.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Raro. +50% de ATQ e Fúria. Falha: o inimigo também recebe +25% de ATQ e Fúria."
          }
        }
      }
    },
    "Rare. 20% control enemy attack. Fail: Void Curse weakens all your attacks.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Raro. 20% de controlar o ataque inimigo. Falha: Maldição do Vazio enfraquece todos os seus ataques."
          }
        }
      }
    },
    "Rare. Auto-dodge next enemy attack. 40% chance your next attack also slows.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Raro. Esquiva automática do próximo ataque inimigo. 40% de chance de seu próximo ataque também desacelerar o inimigo."
          }
        }
      }
    },
    "Rare. Become intangible — next 2 hits pass through you. Cannot attack while intangible.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Raro. Torna-se intangível — os próximos 2 golpes atravessam você. Não pode atacar enquanto intangível."
          }
        }
      }
    },
    "Rare. Control the enemy for 1-3 turns. Death Knight controls undead permanently.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Raro. Controla o inimigo por 1-3 turnos. Cavaleiro da Morte controla mortos-vivos permanentemente."
          }
        }
      }
    },
    "Rare. Deals 10 damage per floor you are on. Weak early. Devastating on floor 10.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Raro. Causa 10 de dano por andar em que você está. Fraco no início. Devastador no andar 10."
          }
        }
      }
    },
    "Rare. Deals damage equal to total damage enemy dealt to you this fight.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Raro. Causa dano igual ao dano total que o inimigo causou a você nesta luta."
          }
        }
      }
    },
    "Rare. Drop to 1 HP. Become unkillable and deal 2x damage for 3 turns.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Raro. Reduz para 1 HP. Torna-se invencível e causa 2x de dano por 3 turnos."
          }
        }
      }
    },
    "Rare. Enemy ATK permanently reduced 40% for fight. Costs massive SP.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Raro. ATQ do inimigo permanentemente reduzido em 40% durante a luta. Custa muito SP."
          }
        }
      }
    },
    "Rare. Enemy cannot attack for 2 turns. You also cannot use items those turns.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Raro. O inimigo não pode atacar por 2 turnos. Você também não pode usar itens nesses turnos."
          }
        }
      }
    },
    "Rare. Enemy frozen in fear for 1 turn. Fail: fear reflects — you freeze and they get a free hit.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Raro. Inimigo paralisado de medo por 1 turno. Falha: o medo se reflete — você paralisa e ele ganha um golpe grátis."
          }
        }
      }
    },
    "Rare. Every enemy attack also damages themselves at 30% for 3 turns.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Raro. Todo ataque inimigo também causa 30% de dano a ele mesmo por 3 turnos."
          }
        }
      }
    },
    "Rare. Heal 15 HP per kill for 3 kills. After 3: hunger drains 15 HP per turn.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Raro. Cura 15 HP por abate, por 3 abates. Depois de 3: a fome drena 15 HP por turno."
          }
        }
      }
    },
    "Rare. Instantly kill any non-boss enemy. You lose 40% current HP.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Raro. Mata instantaneamente qualquer inimigo que não seja chefe. Você perde 40% do HP atual."
          }
        }
      }
    },
    "Rare. Next 3 attacks cannot miss, deal 150% damage. After: take 20 HP damage per oath attack.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Raro. Os próximos 3 ataques não podem errar, causam 150% de dano. Depois: sofre 20 de dano de HP por ataque do juramento."
          }
        }
      }
    },
    "Rare. Only at below 20 HP. Deals damage equal to your MISSING HP.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Raro. Apenas abaixo de 20 HP. Causa dano igual ao HP que falta em você."
          }
        }
      }
    },
    "Rare. Predict enemy attack — roll % to block it fully or partially.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Raro. Prevê o ataque inimigo — sorteia % para bloqueá-lo total ou parcialmente."
          }
        }
      }
    },
    "Rare. Spend your HP to deal massive damage. You choose the sacrifice.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Raro. Gasta seu HP para causar dano massivo. Você escolhe o sacrifício."
          }
        }
      }
    },
    "Rare. Split enemy into 2 at 40% stats for 1 turn. Kill both: massive gold. Kill one: other reforms stronger.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Raro. Divide o inimigo em 2 com 40% dos atributos por 1 turno. Mate ambos: ouro massivo. Mate um: o outro se refaz mais forte."
          }
        }
      }
    },
    "Rare. Tether your soul to the enemy. They die: you heal 50% of their max HP. You die: they also die.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Raro. Prende sua alma à do inimigo. Se ele morrer: você cura 50% do HP máximo dele. Se você morrer: ele também morre."
