require "base64"

default_platform(:ios)

# The iPhone app and what's inside it: the Live Activity and the Apple Watch app.
SIGNED = {
  "DungeonDescent" => "com.dungeon.descent",
  "DDLiveActivity" => "com.dungeon.descent.DDLiveActivity",
  "DungeonWatch" => "com.dungeon.descent.watchkitapp",
}.freeze
MAIN_ID = SIGNED["DungeonDescent"]
PROJECT = File.expand_path("../swift/App/DungeonDescent.xcodeproj", __dir__)
CERTS_REPO = "https://github.com/belgarath534/ios-certificates.git"
NOTES = File.expand_path("../store/en-US/testflight/IOS.txt", __dir__)

platform :ios do
  desc "Build Dungeon Descent for iPhone (with the watch app), sign it with fastlane match and upload it to TestFlight"
  lane :beta do
    setup_ci

    # The workflow's "Find the key Apple accepts" step picks the working key.
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("GOOD_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
      duration: 1200,
      in_house: false
    )

    # The shared App Store certificate, and a profile for each of the three,
    # kept encrypted in the private ios-certificates repo (as for the other games).
    match(
      type: "appstore",
      app_identifier: SIGNED.values,
      git_url: CERTS_REPO,
      git_basic_authorization: Base64.strict_encode64("x-access-token:#{ENV.fetch('CLEAN_CERTS_TOKEN')}"),
      api_key: api_key,
      readonly: false
    )
    team_id = ENV.fetch("sigh_#{MAIN_ID}_appstore_team-id")
    profiles = SIGNED.values.to_h { |id| [id, ENV.fetch("sigh_#{id}_appstore_profile-name")] }
    UI.success("✅ Signing ready (team #{team_id})")

    SIGNED.each do |target, id|
      update_code_signing_settings(
        path: PROJECT,
        targets: [target],
        use_automatic_signing: false,
        team_id: team_id,
        code_sign_identity: "Apple Distribution",
        profile_name: profiles[id],
        bundle_identifier: id
      )
    end

    # One higher than the newest build on TestFlight (from GitHub or Codemagic).
    build_number = latest_testflight_build_number(api_key: api_key, app_identifier: MAIN_ID, initial_build_number: 0).to_i + 1
    UI.message("Build number #{build_number}")

    build_app(
      project: PROJECT,
      scheme: "DungeonDescent",
      configuration: "Release",
      destination: "generic/platform=iOS",
      export_method: "app-store",
      output_directory: "build",
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}",
      export_options: { provisioningProfiles: profiles }
    )
    UI.success("✅ App built and signed")

    upload_to_testflight(
      api_key: api_key,
      changelog: File.exist?(NOTES) ? File.read(NOTES).strip : nil,
      uses_non_exempt_encryption: false,
      distribute_external: false,
      skip_waiting_for_build_processing: false,
      wait_processing_timeout_duration: 2700
    )
    UI.success("🚀 Build #{build_number} is on TestFlight")
  end
end
