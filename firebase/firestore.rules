rules_version = '2';
// Dungeon Descent's Firestore rules (both the (default) and "dungeon-descent"
// databases). Each player reads and writes only their own data, and can delete
// all of it (Settings → Account → Delete Account). Shared lists are readable by
// everyone; players only add or change their own entries. ttsUsage is written by
// the Cloud Function only.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    // The developer's account (Developer Tools → Send Mystery Coins).
    function isDev() { return signedIn() && request.auth.uid == 'WgqZGmnPKeYIymlMkx0aAg8G2T52'; }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // Profile: username, email, title. The developer can look a player up by email.
    match /users/{uid} {
      allow read, write: if isMe(uid);
      allow read: if isDev();

      // Gifts from the developer. Players claim and delete their own.
      match /inbox/{msg} {
        allow read, delete: if isMe(uid);
        allow update: if isMe(uid) && onlyChanges(['claimed', 'claimedAt']);
        allow create: if isDev();
      }
    }

    // Cloud save.
    match /saves/{uid} {
      allow read, write: if isMe(uid);
    }

    // Older score record, read by the High Score screen.
    match /scores/{uid} {
      allow read, write: if isMe(uid);
    }

    // Usernames are unique: whoever holds one owns it.
    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid
                            && (request.method == 'delete' || request.resource.data.uid == request.auth.uid);
    }

    // Global leaderboard: one entry per player.
    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if isMe(uid);
    }

    // Seasonal tournament scores: one entry per player per season.
    match /tournament/{season}/scores/{uid} {
      allow read: if true;
      allow write: if isMe(uid);
    }

    // The obituary: anyone may add a death; nobody edits or removes them.
    match /deaths/{doc} {
      allow read: if true;
      allow create: if request.resource.data.keys().size() <= 20;
      allow update, delete: if false;
    }

    // Community enemies: anyone may create one, and anyone may add a kill (+1).
    // 12.2: whoever made one (signed in) may rename it, re-roll it within the
    // strongest type's limits, or take it out of the dungeons (approved off,
    // never back on); the developer may change any of them.
    match /community_enemies/{doc} {
      allow read: if true;
      allow create: if request.resource.data.keys().size() <= 20;
      allow update: if (onlyChanges(['kills']) && request.resource.data.kills == resource.data.get('kills', 0) + 1)
                    || isDev()
                    || (signedIn() && resource.data.get('ownerUid', '') == request.auth.uid
                        && onlyChanges(['name', 'desc', 'type', 'icon', 'hp', 'atk', 'def', 'editedAt',
                                        'approved', 'deletedByOwner', 'moderatedAt'])
                        && (request.resource.data.approved == false || resource.data.approved == true)
                        && request.resource.data.name is string && request.resource.data.name.size() <= 30
                        && request.resource.data.desc is string && request.resource.data.desc.size() <= 200
                        && request.resource.data.hp is int && request.resource.data.hp <= 600
                        && request.resource.data.atk is int && request.resource.data.atk <= 55
                        && request.resource.data.def is int && request.resource.data.def <= 18);
      allow delete: if false;
    }

    // 12.2 Guilds: up to 20 players. Anyone can see a guild; only members
    // read its chat. You join or leave by changing only your own entry; the
    // leader edits the description, removes members, hands over leadership or
    // disbands it. Weekly Guild Boss damage only goes up, a strike at a time.
    function guild(gid) { return get(/databases/$(database)/documents/guilds/$(gid)).data; }
    function inGuild(gid) { return signedIn() && request.auth.uid in guild(gid).members; }
    function strikeStep(before, after) { return after is int && after >= before && after - before <= 5000; }

    match /guildNames/{key} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['gid', 'uid']);
      allow delete: if isDev() || (signedIn() && (resource.data.uid == request.auth.uid
                                                  || guild(resource.data.gid).leader == request.auth.uid));
    }

    match /guilds/{gid} {
      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['name', 'nameKey', 'desc', 'leader', 'leaderName',
                                                              'members', 'createdAt', 'week', 'weekDamage'])
                    && request.resource.data.leader == request.auth.uid
                    && request.resource.data.members.keys().hasOnly([request.auth.uid])
                    && request.resource.data.name is string && request.resource.data.name.matches("[A-Za-z0-9 '-]{3,24}")
                    && request.resource.data.nameKey == request.resource.data.name.lower()
                    && request.resource.data.desc is string && request.resource.data.desc.size() <= 120
                    && request.resource.data.weekDamage == 0
                    && getAfter(/databases/$(database)/documents/guildNames/$(request.resource.data.nameKey)).data.gid == gid;
      allow update: if isDev() || (signedIn() && (
                      // The leader: description, removing members, a new leader from the members.
                      (resource.data.leader == request.auth.uid
                        && onlyChanges(['desc', 'members', 'leader', 'leaderName'])
                        && request.resource.data.members.keys().hasOnly(resource.data.members.keys())
                        && request.resource.data.leader in request.resource.data.members
                        && request.resource.data.desc is string && request.resource.data.desc.size() <= 120)
                      // Joining or leaving: only your own entry, at most 20, and the leader can't just leave.
                      || (onlyChanges(['members'])
                        && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
                        && request.resource.data.members.size() <= 20
                        && resource.data.leader != request.auth.uid
                        && (!(request.auth.uid in request.resource.data.members)
                            || (request.resource.data.members[request.auth.uid] is string
                                && request.resource.data.members[request.auth.uid].size() <= 20)))
                      // Members: this week's Guild Boss damage.
                      || (request.auth.uid in resource.data.members && onlyChanges(['week', 'weekDamage'])
                        && ((request.resource.data.week == resource.data.week
                             && strikeStep(resource.data.weekDamage, request.resource.data.weekDamage))
                            || (request.resource.data.week != resource.data.week
                             && strikeStep(0, request.resource.data.weekDamage))))));
      allow delete: if isDev() || (signedIn() && resource.data.leader == request.auth.uid);

      match /chat/{msg} {
        allow read: if inGuild(gid) || isDev();
        allow create: if inGuild(gid) && request.resource.data.uid == request.auth.uid
                      && request.resource.data.keys().hasOnly(['uid', 'username', 'message', 'timestamp'])
                      && request.resource.data.message is string && request.resource.data.message.size() <= 200;
        allow delete: if isDev() || (signedIn() && (resource.data.uid == request.auth.uid
                                                    || guild(gid).leader == request.auth.uid));
      }

      match /boss/{week}/hits/{uid} {
        allow read: if true;
        allow create: if isMe(uid) && inGuild(gid) && request.resource.data.keys().hasOnly(['damage', 'name', 'updatedAt'])
                      && strikeStep(0, request.resource.data.damage);
        allow update: if isMe(uid) && inGuild(gid) && request.resource.data.keys().hasOnly(['damage', 'name', 'updatedAt'])
                      && strikeStep(resource.data.damage, request.resource.data.damage);
      }
    }

    // ── Dungeon Descent Chat (swift/Chat) ──
    // Channels like the Discord server, private messages, moderators. The
    // rules are the gatekeeper: the app can't skip the word filter, bans,
    // blocks, the rate limit or who may read what.
    function chatMember(uid) { return get(/databases/$(database)/documents/chat_members/$(uid)).data; }
    function chatMemberAfter(uid) { return getAfter(/databases/$(database)/documents/chat_members/$(uid)).data; }
    function chatJoined() { return signedIn() && exists(/databases/$(database)/documents/chat_members/$(request.auth.uid)); }
    function chatMod() { return isDev() || (chatJoined() && chatMember(request.auth.uid).get('mod', false) == true); }
    function chatTester() { return chatMod() || (chatJoined() && chatMember(request.auth.uid).get('tester', false) == true); }
    function chatBanned(uid) { return exists(/databases/$(database)/documents/chat_bans/$(uid)); }
    function blocked(owner, other) { return exists(/databases/$(database)/documents/chat_members/$(owner)/blocks/$(other)); }
    // Whole words only, so "class", "assassin" and "Scunthorpe" are fine.
    function cleanText(t) {
      return !t.lower().matches('(?s).*\\b(fuck\\w*|motherfuck\\w*|shit|shits|shitty|shitting|bullshit|bitch\\w*|cunt\\w*|nigg\\w*|fag|fags|faggot\\w*|retard\\w*|whore\\w*|slut\\w*|dick|dicks|cock|cocks|pussy|pussies|ass|asshole\\w*|bastard\\w*|piss|pissed|pissing)\\b.*');
    }
    function goodText(t) { return t is string && t.size() >= 1 && t.size() <= 1000 && cleanText(t); }
    // Nobody may pose as staff.
    function reservedName(n) {
      return n.lower().matches('.*(admin|moderator|developer|dungeondescent|official|staff|support).*') || n.lower() in ['dev', 'mod', 'leonardo'];
    }
    // Posting: your own name, signed up and agreed, not banned, and at most a
    // message every 2 seconds (the same batch moves your lastPostAt to now).
    function canPost() {
      return chatJoined() && !chatBanned(request.auth.uid)
          && chatMember(request.auth.uid).get('agreedAt', null) != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.username == chatMember(request.auth.uid).username
          && request.resource.data.ts == request.time
          && goodText(request.resource.data.text)
          && chatMemberAfter(request.auth.uid).lastPostAt == request.time
          && request.time > chatMember(request.auth.uid).lastPostAt + duration.value(2, 's');
    }

    // Reactions: a message's "reactions" map holds one emoji per person; you
    // may only set or remove your own, from a fixed set, and not when banned.
    function reactionOnly() {
      return signedIn() && !chatBanned(request.auth.uid) && onlyChanges(['reactions'])
          && request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data.reactions)
              || request.resource.data.reactions[request.auth.uid] in ['👍', '❤️', '😂', '🔥', '😮', '😢']);
    }

    match /chat_members/{uid} {
      allow read: if signedIn();
      allow create: if isMe(uid)
                    && request.resource.data.keys().hasOnly(['username', 'createdAt', 'lastPostAt', 'agreedAt', 'dmOff'])
                    && request.resource.data.username is string
                    && request.resource.data.username.matches('[A-Za-z0-9_]{3,20}')
                    && (!reservedName(request.resource.data.username) || isDev())
                    && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())).data.uid == uid
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.lastPostAt == request.time;
      // You: agreeing to the rules, private messages off/on, and lastPostAt
      // (only to now, which canPost checks). Moderators: tester. The
      // developer: moderator and trusted (private messages right away).
      allow update: if (isMe(uid) && onlyChanges(['agreedAt', 'dmOff', 'lastPostAt', 'lastSeen'])
                        && request.resource.data.lastPostAt in [resource.data.lastPostAt, request.time]
                        // "Online": only ever stamped with now, or removed (appear offline).
                        && (!('lastSeen' in request.resource.data)
                            || request.resource.data.lastSeen == resource.data.get('lastSeen', null)
                            || request.resource.data.lastSeen == request.time)
                        && (request.resource.data.get('agreedAt', null) == resource.data.get('agreedAt', null)
                            || request.resource.data.agreedAt == request.time))
                    || (chatMod() && onlyChanges(['tester']))
                    || (isDev() && onlyChanges(['mod', 'tester', 'trusted']));
      allow delete: if isMe(uid) || isDev();

      match /blocks/{other} {
        allow read, write: if isMe(uid);
      }
      // Push token and notification choices; only you (and the push server).
      match /private/{doc} {
        allow read, write: if isMe(uid);
      }
    }

    match /chat_bans/{uid} {
      allow read: if signedIn();
      allow create: if chatMod() && uid != request.auth.uid
                    && request.resource.data.keys().hasOnly(['by', 'reason', 'at'])
                    && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time;
      allow delete: if chatMod();
    }

    match /chat_channels/{cid} {
      allow read: if signedIn();
      allow write: if isDev();

      match /messages/{mid} {
        allow read: if signedIn() && (get(/databases/$(database)/documents/chat_channels/$(cid)).data.get('testersOnly', false) != true
                                      || chatTester());
        allow create: if canPost()
                      && request.resource.data.keys().hasOnly(['uid', 'username', 'text', 'ts', 'replyTo'])
                      && (get(/databases/$(database)/documents/chat_channels/$(cid)).data.get('modsPost', false) != true || chatMod())
                      && (get(/databases/$(database)/documents/chat_channels/$(cid)).data.get('testersOnly', false) != true || chatTester());
        // Reacting (anyone who can read it), or pinning (moderators).
        allow update: if (reactionOnly() && (get(/databases/$(database)/documents/chat_channels/$(cid)).data.get('testersOnly', false) != true || chatTester()))
                      || (chatMod() && onlyChanges(['pinned']) && request.resource.data.pinned is bool);
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || chatMod());
      }
    }

    // Private messages: one conversation per pair, "uidA_uidB" (sorted). Only
    // the two of them can read it. A new conversation needs the other person
    // to accept private messages and not to have blocked you, and your
    // account to be a day old (unless the developer marked it trusted).
    function dmPair(pid) { return get(/databases/$(database)/documents/chat_dms/$(pid)).data.members; }
    function dmOther(members) { return members[0] == request.auth.uid ? members[1] : members[0]; }
    function dmAllowed(members) {
      return request.auth.uid in members && members.size() == 2 && members[0] < members[1]
          && !blocked(dmOther(members), request.auth.uid) && !blocked(request.auth.uid, dmOther(members))
          && exists(/databases/$(database)/documents/chat_members/$(dmOther(members)))
          && chatMember(dmOther(members)).get('dmOff', false) != true;
    }
    // Only starting a conversation waits a day; anyone can answer one.
    function dmStart(members) {
      return dmAllowed(members)
          && (chatMember(request.auth.uid).get('trusted', false) == true || chatMod()
              || request.time > chatMember(request.auth.uid).createdAt + duration.value(1, 'd'));
    }

    match /chat_dms/{pid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if chatJoined() && !chatBanned(request.auth.uid)
                    && request.resource.data.keys().hasOnly(['members', 'names', 'lastAt'])
                    && pid == request.resource.data.members[0] + '_' + request.resource.data.members[1]
                    && dmStart(request.resource.data.members);
      allow update: if signedIn() && request.auth.uid in resource.data.members && onlyChanges(['lastAt'])
                    && request.resource.data.lastAt == request.time;
      allow delete: if false;

      match /messages/{mid} {
        allow read: if signedIn() && request.auth.uid in dmPair(pid);
        allow create: if canPost() && dmAllowed(dmPair(pid))
                      && request.resource.data.keys().hasOnly(['uid', 'username', 'text', 'ts', 'replyTo']);
        allow update: if reactionOnly() && request.auth.uid in dmPair(pid);
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }

    // Group chats: up to 20 people; only members read them. The owner makes
    // the group (just them, after the same day's wait as private messages),
    // then adds people one at a time, never someone who blocked them or
    // turned private messages off. The owner renames it and removes people;
    // anyone can leave (the owner can't, until they hand it over).
    function groupData(gid) { return get(/databases/$(database)/documents/chat_groups/$(gid)).data; }
    function inGroup(gid) { return signedIn() && request.auth.uid in groupData(gid).members; }
    function goodGroupName(n) { return n is string && n.size() >= 1 && n.size() <= 40 && cleanText(n); }

    match /chat_groups/{gid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if chatJoined() && !chatBanned(request.auth.uid)
                    && request.resource.data.keys().hasOnly(['name', 'owner', 'members', 'createdAt', 'lastAt'])
                    && request.resource.data.owner == request.auth.uid
                    && request.resource.data.members.keys().hasOnly([request.auth.uid])
                    && request.resource.data.members[request.auth.uid] == chatMember(request.auth.uid).username
                    && goodGroupName(request.resource.data.name)
                    && request.resource.data.createdAt == request.time
                    && (chatMember(request.auth.uid).get('trusted', false) == true || chatMod()
                        || request.time > chatMember(request.auth.uid).createdAt + duration.value(1, 'd'));
      allow update: if signedIn() && request.auth.uid in resource.data.members && !chatBanned(request.auth.uid) && (
                      // Anyone: the time of the last message.
                      (onlyChanges(['lastAt']) && request.resource.data.lastAt == request.time)
                      // Leaving (not the owner).
                      || (onlyChanges(['members']) && resource.data.owner != request.auth.uid
                          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
                          && !(request.auth.uid in request.resource.data.members))
                      // The owner: rename, remove people, hand it over to a member.
                      || (resource.data.owner == request.auth.uid && onlyChanges(['name', 'members', 'owner'])
                          && goodGroupName(request.resource.data.name)
                          && request.resource.data.members.keys().hasOnly(resource.data.members.keys())
                          && request.resource.data.owner in request.resource.data.members)
                      // The owner: add one person (named in "added"), who accepts
                      // messages and hasn't blocked them.
                      || (resource.data.owner == request.auth.uid && onlyChanges(['members', 'added'])
                          && request.resource.data.members.size() <= 20
                          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.resource.data.added])
                          && request.resource.data.added in request.resource.data.members
                          && !(request.resource.data.added in resource.data.members)
                          && groupAddOk(request.resource.data.added, request.resource.data.members)));
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      match /messages/{mid} {
        allow read: if inGroup(gid);
        allow create: if canPost() && inGroup(gid)
                      && request.resource.data.keys().hasOnly(['uid', 'username', 'text', 'ts', 'replyTo']);
        allow update: if reactionOnly() && inGroup(gid);
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }
    function groupAddOk(uid, members) {
      return exists(/databases/$(database)/documents/chat_members/$(uid))
          && members[uid] == chatMember(uid).username
          && chatMember(uid).get('dmOff', false) != true
          && !blocked(uid, request.auth.uid) && !blocked(request.auth.uid, uid) && !chatBanned(uid);
    }

    // Reports go to the moderators. A private message report carries the
    // reported message and a few around it (the reporter could read them).
    match /chat_reports/{rid} {
      allow create: if chatJoined()
                    && request.resource.data.keys().hasOnly(['by', 'byName', 'kind', 'path', 'author', 'authorName', 'text', 'context', 'reason', 'at'])
                    && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time
                    && request.resource.data.reason is string && request.resource.data.reason.size() <= 500;
      allow read, delete: if chatMod();
    }

    // Everything else (ttsUsage …) is server-only.
  }
}
