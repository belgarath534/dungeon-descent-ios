                  ScrollView, 0x134729760, {{327.2, 142.8}, {369.6, 429.7}} <AX element pid: 14411, token: SzgAAAAAAABvY29j/v///////3/+////////f0s4AAAA3JxJAQAAAA0AAAAAAAAA>
                    Other, 0x1347298a0, {{327.2, 142.8}, {369.6, 451.2}} <AX element pid: 14411, token: SzgAAAAAAABvY29j/v///////3/+////////f0s4AACwMXpIAQAAABEAAAAAAAAA>
                      StaticText, 0x1347299e0, {{483.2, 159.8}, {57.8, 20.8}}, label: '🎉 v11.8' <AX element pid: 14411, token: SzgAAAAAAABvY29j/v///////3/+////////f0s4AAAAY+gAAGAAACMAAAAAAAAA>
                      StaticText, 0x134729b20, {{453.1, 188.2}, {117.8, 11.5}}, label: 'The Festival Update' <AX element pid: 14411, token: SzgAAAAAAABvY29j/v///////3/+////////f0s4AACAfugAAGAAACQAAAAAAAAA>
                      StaticText, 0x134729c60, {{344.2, 207.5}, {329.6, 46.2}}, label: '• 🎉 Nine new events come to the dungeon, each with its own enemies, bonuses and twist. Check the Events screen in the menu to see when each one is on.' <AX element pid: 14411, token: SzgAAAAAAABvY29j/v///////3/+////////f0s4AADgX+gAAGAAACUAAAAAAAAA>
                      StaticText, 0x134729ef0, {{344.2, 261.4}, {335.7, 46.2}}, label: '• 🌼 Día de los Muertos (November 1–2) — a fallen hero from your Graveyard returns as a ghost and fights beside you. Earn Marigolds and spend them at 🌼 The Ofrenda.' <AX element pid: 14411, token: SzgAAAAAAABvY29j/v///////3/+////////f0s4AABgZ+gAAGAAACYAAAAAAAAA>
                      StaticText, 0x13472a030, {{344.2, 315.3}, {325.7, 30.0}}, label: '• 🇲🇽 Independencia de México (September 15–16) — the ¡El Grito! battle cry gives you +30% attack for 3 turns, once a fight.' <AX element pid: 14411, token: SzgAAAAAAABvY29j/v///////3/+////////f0s4AABAc+gAAGAAACcAAAAAAAAA>
                      StaticText, 0x13472a400, {{344.2, 353.0}, {309.5, 13.9}}, label: '• 🎆 New Year (December 31–January 1) — double XP into the new year.' <AX element pid: 14411, token: SzgAAAAAAABvY29j/v///////3/+////////f0s4AACgfOgAAGAAACgAAAAAAAAA>
                      StaticText, 0x13472a540, {{344.2, 374.6}, {304.2, 30.0}}, label: '• 🐉 Lunar New Year — three days that move with the moon. Enemies sometimes leave a 🧧 red envelope with gold or a Mystery Coin.' <AX element pid: 14411, token: SzgAAAAAAABvY29j/v///////3/+////////f0s4AADAcOgAAGAAACkAAAAAAAAA>
                      StaticText, 0x13472a7a0, {{344.2, 412.3}, {256.4, 13.9}}, label: '• 🃏 Chaos Day (April 1) — every fight rolls a random twist.' <AX element pid: 14411, token: SzgAAAAAAABvY29j/v///////3/+////////f0s4AAAgcOgAAGAAACoAAAAAAAAA>
                      StaticText, 0x13472a8e0, {{344.2, 433.9}, {329.6, 30.0}}, label: '• 🌑 The Longest Night (December 21) — it is night all day, with every night bonus on.' <AX element pid: 14411, token: SzgAAAAAAABvY29j/v///////3/+////////f0s4AABAfegAAGAAACsAAAAAAAAA>
                      StaticText, 0x13472aa20, {{344.2, 471.6}, {334.2, 30.0}}, label: '• 🌘 The Eclipse — one evening a month the sun goes dark, the same time for every player. Double gold, and much tougher enemies.' <AX element pid: 14411, token: SzgAAAAAAABvY29j/v///////3/+////////f0s4AADgbugAAGAAACwAAAAAAAAA>
                      StaticText, 0x13472ac80, {{344.2, 509.3}, {328.8, 30.0}}, label: '• 🏮 Night Market — the first weekend of every month, the merchant comes far more often and everything is 25% off.' <AX element pid: 14411, token: SzgAAAAAAABvY29j/v///////3/+////////f0s4AABgWOgAAGAAAC0AAAAAAAAA>
                      StaticText, 0x13472adc0, {{344.2, 547.1}, {301.8, 30.0}}, label: '• 🐾 Monster Migration — two days a month, enemies from the other dungeons wander into yours with all their abilities.' <AX element pid: 14411, token: SzgAAAAAAABvY29j/v///////3/+////////f0s4AACAaugAAGAAAC4AAAAAAAAA>
                    Other, 0x13472b010, {{685.3, 142.8}, {11.5, 429.7}} <AX element pid: 14411, token: SzgAAAAAAABvY29j/v///////3/+////////f0s4AADg6ghKAQAAABIAAAAAAAAA>
